# For more details, see docs/portfolio/implementation-notes.md#public-headers-note-1.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# For more details, see docs/portfolio/implementation-notes.md#public-headers-note-2.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/privacy/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/terms/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/security/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8

# RFC 9116 security.txt (plan32): plain text, short cache so Expires stays fresh
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
