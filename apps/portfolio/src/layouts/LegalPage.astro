---
/**
 * @file layouts/LegalPage.astro
 * @description Shell for the plain-text policy pages (/privacy/, /terms/, /security/) —
 *              one readable column inside the portfolio's panel language:
 *              brand rail on top, bordered surface, display-serif H1, Lilex
 *              mono meta line, theme tokens only (plan31).
 *
 * WHY STANDALONE (same reason as pages/404.astro): Layout.astro's sidebar
 * and mobile menu are `#section` anchors that only work on the home page.
 * This shell reuses BaseHead (fonts, theme, CSP-safe anti-flash script,
 * canonical, OG) and links home with absolute `/#…` hrefs.
 *
 * WHY THE PROSE STYLES LIVE HERE: the page content arrives through <slot/>,
 * which keeps the PAGE's style scope, so `.legal :global(h2)` (not a plain
 * scoped selector) styles it. One small rule set instead of a typography
 * plugin for two pages.
 *
 * POC:
 *   <LegalPage title="Privacy policy" description="…" updated="2026-10-23">
 *     <h2>…</h2><p>…</p>
 *   </LegalPage>
 */
import "../styles/global.css";
import BaseHead from "./BaseHead.astro";
import { portfolioData } from "../data/portfolio";

interface Props {
  title: string;
  description: string;
  /** ISO date of the last content change, shown and used as <time datetime> */
  updated: string;
}

const { title, description, updated } = Astro.props;
const { meta } = portfolioData;
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/terms/", label: "Terms" },
  { href: "/security/", label: "Security" },
  { href: meta.blogUrl, label: "Blog" },
];
const updatedText = new Date(updated).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} · ${meta.handle}.dev`} description={description} />
  </head>

  <body class="min-h-dvh bg-frame-background p-4 text-default antialiased md:py-10">
    <main class="mx-auto w-full max-w-3xl">
      <div aria-hidden="true" class="grid h-1.5 grid-cols-8">
        <span class="col-span-3 bg-accent"></span>
        <span class="col-span-2 bg-line"></span>
        <span class="col-span-3 bg-delta-blue"></span>
      </div>

      <div class="border border-t-0 border-line bg-surface">
        <nav aria-label="Site" class="flex flex-wrap gap-x-5 gap-y-1 border-b border-line px-5 py-3 md:px-10">
          {
            links.map((l) => (
              <a
                href={l.href}
                aria-current={l.href === path ? "page" : undefined}
                class="flex min-h-8 items-center font-mono text-2xs uppercase tracking-widest text-muted transition-colors hover:text-accent aria-[current=page]:text-accent"
              >
                {l.label}
              </a>
            ))
          }
        </nav>

        <header class="border-b border-line px-5 py-8 md:px-10 md:py-10">
          <h1 class="font-display text-[clamp(2rem,3vw+1rem,3rem)] leading-[1.05] tracking-tight">
            {title}<span class="text-accent">.</span>
          </h1>
          <p class="mt-3 font-mono text-2xs uppercase tracking-widest text-muted">
            Last updated <time datetime={updated}>{updatedText}</time> · applies to {meta.handle}.dev and blog.{meta.handle}.dev
          </p>
        </header>

        <article class="legal px-5 py-8 md:px-10 md:py-10">
          <slot />
        </article>
      </div>
    </main>
  </body>
</html>

<style>
  .legal {
    max-width: 68ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-subtle);
  }
  .legal :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
    color: var(--color-default);
  }
  .legal :global(h2:first-child) {
    margin-top: 0;
  }
  .legal :global(h3) {
    margin: 1.75rem 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-default);
  }
  .legal :global(p),
  .legal :global(ul) {
    margin: 0 0 1rem;
  }
  .legal :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal :global(li) {
    margin: 0.35rem 0;
  }
  .legal :global(li::marker) {
    color: var(--color-muted);
  }
  .legal :global(strong) {
    color: var(--color-default);
    font-weight: 600;
  }
  .legal :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-default);
  }
  .legal :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal :global(a:hover) {
    color: var(--color-accent-hover);
  }
  .legal :global(.summary) {
    margin-bottom: 2rem;
    border-left: 2px solid var(--color-accent);
    padding: 0.25rem 0 0.25rem 1rem;
    color: var(--color-default);
  }
</style>
