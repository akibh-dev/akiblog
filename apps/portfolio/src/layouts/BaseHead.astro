---
/* For more details, see docs/portfolio/implementation-notes.md#src-layouts-basehead-astro-note-1. */
import { getImage } from "astro:assets";
import { portfolioData } from "../data/portfolio";
import portrait from "../assets/my-pic.png";

interface Props {
  title?: string;
  description?: string;
  /** keep the page out of search indexes (404) */
  noindex?: boolean;
}

const { meta, socials, competitiveMetrics, skills, education } = portfolioData;
const {
  /* searchName first: it's what people type (50 chars, no truncation) */
  title = `${meta.searchName} — ${meta.role}`,
  description = `Portfolio of ${meta.name} — ${meta.role} in ${meta.location}. ${meta.statusText}.`,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(meta.siteUrl);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;
const headshot = await getImage({ src: portrait, width: 600, format: "jpg" });
const headshotUrl = new URL(headshot.src, site).href;
/* only "/" is ABOUT the Person (ProfilePage, og:type profile); the policy
   pages (plan31/32) are plain WebPages of the same site — a ProfilePage
   there would tell Google /privacy/ is a second profile of the same person */
const isHome = Astro.url.pathname === "/";
const xHandle = socials.find((s) => s.name === "X")?.handle;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.origin}/#person`,
      name: meta.searchName,
      alternateName: [meta.name, "Md. Akib Hasan", "Akib", meta.handle],
      jobTitle: meta.role,
      url: site.origin,
      image: headshotUrl,
      description: `${meta.role} in ${meta.location}. ${meta.statusText}.`,
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Chittagong University of Engineering & Technology",
        alternateName: "CUET",
        url: education.url,
      },
      knowsAbout: skills.flatMap((g) => g.skills).slice(0, 15),
      email: `mailto:${meta.email}`,
      address: { "@type": "PostalAddress", addressLocality: "Dhaka", addressCountry: "BD" },
      sameAs: [...socials.map((s) => s.url), ...competitiveMetrics.map((m) => m.url), meta.blogUrl],
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      url: site.origin,
      name: `${meta.handle}.dev`,
      alternateName: meta.searchName,
      author: { "@id": `${site.origin}/#person` },
      inLanguage: "en",
    },
    isHome
      ? {
          "@type": "ProfilePage",
          "@id": `${canonical}#profilepage`,
          url: canonical,
          name: title,
          isPartOf: { "@id": `${site.origin}/#website` },
          mainEntity: { "@id": `${site.origin}/#person` },
          inLanguage: "en",
        }
      : {
          "@type": "WebPage",
          "@id": `${canonical}#webpage`,
          url: canonical,
          name: title,
          description,
          isPartOf: { "@id": `${site.origin}/#website` },
          publisher: { "@id": `${site.origin}/#person` },
          inLanguage: "en",
        },
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={meta.name} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

{/* Icons share assets/Paint-Fill A@1x.png artwork so browsers, Search, and iOS use the same brand. */}
<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${meta.name} — blog`} href={`${meta.blogUrl}/rss.xml`} />
<meta name="theme-color" content="#fcf7f7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1c1f23" media="(prefers-color-scheme: dark)" />

{/* Open Graph + Twitter */}
<meta property="og:type" content={isHome ? "profile" : "website"} />
<meta property="og:site_name" content={`${meta.handle}.dev`} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${meta.name} — ${meta.role}`} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
{xHandle && <meta name="twitter:creator" content={`@${xHandle}`} />}

{!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<script is:inline>
  (() => {
    const t = localStorage.getItem("theme");
    if (t !== "light") document.documentElement.classList.add("dark");
  })();
</script>

<link rel="preload" href="/fonts/iAWriterQuattroV.woff2" as="font" type="font/woff2" crossorigin />

<style is:inline>
  @font-face {
    font-family: "iA Writer Quattro S";
    src: url("/fonts/iAWriterQuattroV.woff2") format("woff2");
    font-weight: 100 900;
    font-display: swap;
  }
  @font-face {
    font-family: "IBM Plex Serif";
    src: url("/fonts/IBMPlexSerif-Var.woff2") format("woff2");
    font-weight: 100 900;
    font-display: swap;
  }
  @font-face {
    font-family: "Lilex";
    src: url("/fonts/Lilex-Regular.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }
</style>
