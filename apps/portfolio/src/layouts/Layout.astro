---
/* For more details, see docs/portfolio/implementation-notes.md#src-layouts-layout-astro-note-1. */
import "../styles/global.css";
import ViewportFrame from "../components/layout/ViewportFrame.astro";
import SiteSidebar from "../components/layout/SiteSidebar.astro";
import MobileHeader from "../components/layout/MobileHeader.astro";
import BaseHead from "./BaseHead.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} />
  </head>

  <body class="relative bg-frame-background text-default antialiased">
    <ViewportFrame />
    <MobileHeader />

    {/* scrolling layer — mirrors the chrome grid (same page-left/right
        margins); z-0 keeps content under the fixed chrome while still
        stacking tooltips/dialogs correctly inside it */}
    <div
      id="top"
      class="relative z-0 grid ml-(--site-page-left) mr-(--site-page-right) grid-cols-(--site-columns) pt-(--site-frame-top) pb-(--site-content-bottom)"
    >
      <SiteSidebar />
      {/* main content track — pt-rail leaves the 6px fixed rail visible
          above; the first paint of the rail's right edge continues into
          main's own border-r (delta verbatim) */}
      <main id="main-content" tabindex="-1" class="relative col-(--site-main-column) min-w-0 pt-(--site-rail-height) border-line md:border-r focus-visible:outline-none">
        {/* For more details, see docs/portfolio/implementation-notes.md#src-layouts-layout-astro-note-2. */}
        <slot />
      </main>
    </div>

    <script>
      /* For more details, see docs/portfolio/implementation-notes.md#src-layouts-layout-astro-note-3. */
      const cleanUrl = () => {
        if (location.hash) history.replaceState(history.state, "", location.pathname + location.search);
      };

      const focusTarget = (el: HTMLElement) => {
        if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "-1");
        el.focus({ preventScroll: true });
      };

      const scrollToId = (id: string, behavior: ScrollBehavior = "auto") => {
        if (id === "top") {
          window.scrollTo({ top: 0, behavior });
          return;
        }
        const el = document.getElementById(id);
        if (!el) return;
        el.scrollIntoView({ block: "start", behavior });
        focusTarget(el);
      };

      const whenNoDialog = (run: () => void, deadline = performance.now() + 1000) => {
        if (!document.querySelector('[role="dialog"]') || performance.now() > deadline) run();
        else requestAnimationFrame(() => whenNoDialog(run, deadline));
      };

      document.addEventListener("click", (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
        const id = a?.getAttribute("href")?.slice(1);
        if (!a || !id || (id !== "top" && !document.getElementById(id))) return;
        e.preventDefault();
        if (a.closest('[role="dialog"]')) whenNoDialog(() => scrollToId(id));
        else scrollToId(id);
      });

      const initial = decodeURIComponent(location.hash.slice(1));
      cleanUrl();
      if (initial) {
        const jump = () => scrollToId(initial, "instant");
        if (document.readyState === "complete") jump();
        else window.addEventListener("load", jump, { once: true });
      }
      window.addEventListener("hashchange", cleanUrl);
    </script>
  </body>
</html>
