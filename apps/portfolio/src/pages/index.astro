---
/* For more details, see docs/portfolio/implementation-notes.md#src-pages-index-astro-note-1. */
import Layout from "../layouts/Layout.astro";
import Seam from "../components/ui/Seam.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Projects from "../components/sections/Projects.astro";
import Writings from "../components/sections/Writings.astro";
import Skills from "../components/sections/Skills.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/sections/Footer.astro";
import { sections } from "../data/sections";

/* id → panel binding. All panels are no-prop section components, so
   `typeof Hero` is the shared signature without importing astro types. */
const panels: Record<string, typeof Hero> = {
  home: Hero,
  about: About,
  projects: Projects,
  writings: Writings,
  skills: Skills,
  contact: Contact,
};
---

<Layout>
  {
    sections.map((entry, i) => {
      const Panel = panels[entry.id];
      if (!Panel) {
        throw new Error(
          `index.astro: no panel bound for section id "${entry.id}" — add one import + one record line (see @file header).`,
        );
      }
      return (
        <Fragment>
          {i > 0 && <Seam />}
          <Panel />
        </Fragment>
      );
    })
  }
  {/* site footer — full-bleed Square Kufic panel (sections/Footer.astro).
      Deliberately OUTSIDE the nav registry: no sidebar station, just the
      closing band after the last seam. */}
  <Seam />
  <Footer />
</Layout>
