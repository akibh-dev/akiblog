---
/**
 * @file src/pages/icons.astro
 * @description Icon set preview gallery (design-system reference page).
 *
 * Renders every glyph from src/icons on theme tokens with a light/dark
 * toggle, so new icons can be verified against BOTH themes before use.
 * Safe to delete if you don't want this route in production.
 */
import "../styles/global.css";
import * as icons from "../icons";

const entries = Object.entries(icons).sort(([a], [b]) => a.localeCompare(b));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Icon Set — akib35.dev</title>
  </head>
  <body class="bg-canvas font-body text-default">
    <main class="mx-auto max-w-5xl px-6 py-12">
      <header class="mb-10 flex items-end justify-between">
        <div>
          <h1 class="font-display text-3xl">Icon Set</h1>
          <p class="mt-2 font-mono text-xs text-muted">
            {entries.length} glyphs · stroke 1.8 · currentColor · 24×24
          </p>
        </div>
        <button
          id="theme-toggle"
          class="rounded-sm border border-line-subtle bg-surface px-4 py-2 font-mono text-xs text-subtle transition-colors hover:border-accent hover:text-default"
        >
          toggle dark / light
        </button>
      </header>

      {/* theme-adaptivity demo: same icon, three token colors */}
      <section class="mb-10 rounded-md border border-line-subtle bg-surface p-5">
        <p class="mb-4 font-mono text-2xs uppercase tracking-wider text-muted">
          One glyph, three tokens — flips automatically with .dark
        </p>
        <div class="flex items-center gap-8">
          <icons.GitHubIcon class="size-7 text-default" />
          <icons.GitHubIcon class="size-7 text-muted" />
          <icons.GitHubIcon class="size-7 text-accent" />
        </div>
      </section>

      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        {
          entries.map(([name, Icon]) => (
            <li class="group flex flex-col items-center gap-3 rounded-md border border-line-subtle bg-surface p-5 transition-colors hover:border-accent">
              <Icon class="size-7 text-subtle transition-colors group-hover:text-accent" />
              <span class="font-mono text-2xs text-muted">{name.replace(/Icon$/, "")}</span>
            </li>
          ))
        }
      </ul>
    </main>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");
      });
    </script>
  </body>
</html>
