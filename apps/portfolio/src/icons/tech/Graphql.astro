---
/**
 * Icon: GraphQL — hexagon outline with inscribed inverted triangle web and
 * the signature six vertex nodes. Theme-aware via currentColor.
 */
import IconBase from "../IconBase.astro";
---

<IconBase {...Astro.props}>
  <path d="M12 3.5 L19.4 7.75 V16.25 L12 20.5 L4.6 16.25 V7.75 Z" />
  <path d="M12 20.5 L4.6 7.75 H19.4 Z" />
  <circle cx="12" cy="3.5" r="1.05" fill="currentColor" stroke="none" />
  <circle cx="19.4" cy="7.75" r="1.05" fill="currentColor" stroke="none" />
  <circle cx="19.4" cy="16.25" r="1.05" fill="currentColor" stroke="none" />
  <circle cx="12" cy="20.5" r="1.05" fill="currentColor" stroke="none" />
  <circle cx="4.6" cy="16.25" r="1.05" fill="currentColor" stroke="none" />
  <circle cx="4.6" cy="7.75" r="1.05" fill="currentColor" stroke="none" />
</IconBase>
