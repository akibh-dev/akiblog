  <rect x="11.7" y="9.2" width="2.9" height="2.9" />
  <rect x="8.3" y="5.8" width="2.9" height="2.9" />
  <rect x="11.7" y="5.8" width="2.9" height="2.9" />
  <path d="M3.1 14 H20.9 A6.6 6.6 0 0 1 14.3 20.6 H9.7 A6.6 6.6 0 0 1 3.1 14 Z" />
