---
/**
 * Icon: Python — the official two-snake mark as ONE point-symmetric
 * construction: a single S-stroke forms both snakes' inner bodies, and two
 * rounded "lips" (left-top, right-bottom) form their outer heads/tails.
 * Every point maps to its partner via (x,y) → (24−x, 24−y), so the mark is
 * exactly balanced. Redrawn: the previous version read as a blob/"8" at
 * 16–20px because the heads had no outer lips.
 * Theme-aware via currentColor (see IconBase.astro).
 */
import IconBase from "../IconBase.astro";
---

<IconBase {...Astro.props}>
  <path d="M8 9.5 V6 A2.5 2.5 0 0 1 10.5 3.5 H13.5 A2.5 2.5 0 0 1 16 6 V10 A2 2 0 0 1 14 12 H10 A2 2 0 0 0 8 14 V18 A2.5 2.5 0 0 0 10.5 20.5 H13.5 A2.5 2.5 0 0 0 16 18 V14.5" />
  <path d="M12 9.5 H5.5 A2 2 0 0 0 3.5 11.5 V14 A2 2 0 0 0 5.5 16 H8" />
  <path d="M12 14.5 H18.5 A2 2 0 0 0 20.5 12.5 V10 A2 2 0 0 0 18.5 8 H16" />
  <circle cx="10.6" cy="6.1" r="0.9" fill="currentColor" stroke="none" />
  <circle cx="13.4" cy="17.9" r="0.9" fill="currentColor" stroke="none" />
</IconBase>
