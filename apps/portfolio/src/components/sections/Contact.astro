---
/**
 * @file sections/Contact.astro
 * @description Contact section — editorial "pricing-page" layout in the
 *              delta.dev language: ONE flat surface, structure drawn with
 *              hairlines only. NO cards, NO boxed panels, NO numbered
 *              eyebrow header.
 *
 * WHY THIS IMPLEMENTATION (POC / rationale):
 *
 * 1. LINES, NOT BOXES — delta.dev's pricing page separates tiers with
 *    vertical hairlines on a single background, never stacked cards. The
 *    site's own design contract (SectionShell.astro) says the same:
 *    "structure reads through lines + hatch on ONE background". So the
 *    form sits directly on the section surface and the aside is divided
 *    from it by a single `border-l` (a `border-t` on mobile when stacked).
 *
 * 2. ASIDE ROWS = PRICE-TABLE ROWS — socials/email/location are rendered
 *    as full-width rows separated by `divide-y` hairlines (like delta's
 *    feature lists), with mono labels and an arrow that slides on hover.
 *    Zero chrome: no bg-canvas, no border, no radius, no padding boxes.
 *
 * 3. FLAT FIELDS — inputs keep the site's hairline field style but drop
 *    the card background (`bg-transparent` over the section surface), so
 *    the form reads as ruled lines on paper rather than an inset panel.
 *
 * 4. LIVE LOCAL TIME — a tiny module script ticks the visitor's view of
 *    my Dhaka (UTC+6) clock. Costs ~10 lines of JS, adds the "instrument
 *    panel" honesty delta.dev uses for stats, and answers the practical
 *    question "is he awake?" before hitting send.
 *
 * 5. HEADERLESS SectionShell — index/label are omitted, so no
 *    "05. Transmission" eyebrow renders. The heading + subtitle use the
 *    same type pair as Skills/Writings (font-display 2xl→3xl title,
 *    font-mono xs subtitle) so every section header reads as one system.
 *
 * 6. BRAND ICONS — email/social rows use the project's own stroke icon set
 *    (src/icons/social): currentColor glyphs that inherit the muted→accent
 *    hover color transition for free and auto-flip with the theme.
 *
 * 7. NO FOOTER BAR — the section ends with the aside grid. The Square
 *    Kufic colophon moved to its own full-bleed panel (sections/
 *    Footer.astro, Projects-IDE contract: pad="p-0", headerless), and
 *    the copyright/Edge texts were removed per request.
 *
 * 7b. BUTTONS — "Send Message" is the page's PRIMARY button (global.css
 *    `btn-primary`); "Copy" is SECONDARY (`btn`, via CopyButton). Both
 *    carry cursor:pointer + the shared brand hover halo.
 *
 * 7c. SEND BUTTON STATES — the mailer answers only after Cloudflare has
 *    actually handed the email over, which takes a few seconds. Faking
 *    an instant "sent" would lie on failures, so the wait stays honest and
 *    is made legible instead:
 *    - sending: the arrow becomes a spinner, a thin progress bar eases
 *      toward ~90% (it never reaches 100% on its own), and the label
 *      walks real stages: Verifying → Sending → Delivering → Almost there.
 *    - sent: the bar completes, a check mark draws itself, a ring pulses
 *      once, and the status line gives a receipt (time + the address
 *      the reply will go to). After a few seconds it returns to idle,
 *      and the receipt fades out ~7s later so it doesn't linger.
 *    - error: a short shake, and the mailer's own message is shown.
 *    The button is never `disabled` while busy (that would fade it via
 *    btn-primary:disabled); aria-disabled + a state guard block double
 *    submits. All motion is CSS, and prefers-reduced-motion turns it off.
 *
 * 8. FORM BACKEND — same-origin POST /api/contact (Pages Function, functions/api/contact.ts), which
 *    forwards to the private `mailer` Worker (akibh-dev/mailer) over a
 *    service binding; the mailer has no public URL at all. Vanilla-TS
 *    submit handler (see the first <script>): fetch POST JSON. Bot/abuse
 *    protection is Cloudflare Turnstile — the client holds ONLY the
 *    public site key; the secret lives in the mailer. Rationale + notes
 *    live above the script.
 *
 * 8b. LAZY TURNSTILE — api.js used to load with the page. It's ~50KB of
 *    third-party JS plus an iframe for a form at the very bottom, it
 *    logged errors for every headless visitor (Lighthouse), and its
 *    iframe disqualified the page from the back/forward cache. Now the
 *    script is injected once, when the first of these happens:
 *      - the form comes within 600px of the viewport (IntersectionObserver),
 *      - anything inside the form gets focus (keyboard users tabbing in),
 *      - the form is submitted.
 *    A real visitor scrolling to the form gets the widget before they
 *    reach it, so the flow is unchanged; the existing "still loading"
 *    guard covers a submit that beats the challenge.
 */
import SectionShell from "../ui/SectionShell.astro";
import CopyButton from "../islands/CopyButton.astro";
import { portfolioData } from "../../data/portfolio";
import { MailIcon, GitHubIcon, LinkedInIcon, XIcon, FacebookIcon } from "../../icons";

const { meta, socials } = portfolioData;

/* social name (data/portfolio.ts) → brand glyph */
const socialIcons: Record<string, typeof GitHubIcon> = {
  GitHub: GitHubIcon,
  LinkedIn: LinkedInIcon,
  X: XIcon,
  Facebook: FacebookIcon,
};

const fieldClass =
  "w-full rounded-sm border border-line-subtle bg-transparent px-4 py-3 font-mono text-sm text-default placeholder:text-muted transition-colors focus:border-accent focus:outline-none";
const labelClass =
  "mb-2 block font-mono text-2xs uppercase tracking-wider text-muted";
---

<SectionShell id="contact" pad="px-5 md:px-8 pt-8 md:pt-12 pb-10">
  {/* headline — same scale as Skills/Writings headers, one accent mark */}
  <h2 class="font-display text-2xl text-default md:text-3xl">
    Let's connect<span class="text-accent">.</span>
  </h2>
  <p class="mt-2 max-w-lg font-mono text-xs leading-relaxed text-subtle">
    Have an opportunity, a collaboration idea, or just want to say hi? My inbox is always open.
  </p>

  {/* two columns split by a single hairline */}
  <div class="mt-10 grid gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)]">
    {/* ── form — straight on the surface, no wrapper ──
        Backend: same-origin /api/contact → mailer binding (see note 8).
        No action attribute: submission is JS-driven (fetch JSON), the
        endpoint travels in data-endpoint so the script stays generic. */}
    <form id="contact-form" data-endpoint="/api/contact" class="space-y-6">
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="name" class={labelClass}>Name</label>
          <input id="name" name="name" type="text" required maxlength="200" placeholder="Your name" class={fieldClass} />
        </div>
        <div>
          <label for="email" class={labelClass}>Email</label>
          <input id="email" name="email" type="email" required placeholder="you@example.com" class={fieldClass} />
        </div>
      </div>

      <div>
        <label for="message" class={labelClass}>Message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          maxlength="5000"
          placeholder="Tell me about your project or idea…"
          class:list={[fieldClass, "min-h-[160px] resize-none"]}></textarea>
      </div>

      {/* honeypot — invisible to humans (display:none, tab skip), bots
          fill it; the script silently drops such submissions and the
          worker rejects them server-side too (see API spec) */}
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

      {/* Cloudflare Turnstile — bot check. The SITE key is public by
          design (it only renders the challenge); verification happens
          in the worker with the secret key. The widget auto-injects a
          hidden cf-turnstile-response input inside this form, so the
          script below reads the token straight from FormData.
          LAZY: api.js is injected by the form script only when the form
          nears the viewport (note 8b); it then renders this div itself
          (implicit rendering). min-h reserves the widget's 65px so the
          Send button doesn't jump when it appears. */}
      <div class="flex flex-col gap-4 pt-1 sm:items-end">
        <div class="cf-turnstile min-h-[65px]" data-sitekey="0x4AAAAAACMqP-_QKElZMAeg" data-theme="auto"></div>
        {/* send button — a small state machine (data-state: idle →
            sending → sent | error, see note 7c). Fixed min-width so the
            label swaps never resize it; nowrap so it never breaks to two
            lines in the narrow form column. */}
        <button
          id="contact-submit"
          type="submit"
          data-state="idle"
          class="send-btn btn-primary relative inline-flex w-full items-center justify-center gap-3 overflow-hidden whitespace-nowrap rounded-sm px-7 py-3 font-mono text-xs font-medium uppercase tracking-wider sm:w-auto sm:min-w-56"
        >
          <span data-label>Send message</span>
          <span class="send-icon relative size-4 shrink-0" aria-hidden="true">
            <svg class="send-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            <svg class="send-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="8" opacity=".3" /><path d="M20 12a8 8 0 0 0-8-8" /></svg>
            <svg class="send-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          </span>
          <span class="send-bar" aria-hidden="true"></span>
        </button>
        {/* inline status — its own line under the button (never squeezed
            beside it); aria-live so screen readers announce the result */}
        <p id="contact-status" role="status" aria-live="polite" class="min-h-4 font-mono text-2xs text-muted sm:text-right"></p>
      </div>
    </form>

    {/* ── aside — hairline-divided rows, price-table style ── */}
    <aside class="border-t border-line pt-10 lg:border-l lg:border-t-0 lg:pt-0 lg:pl-14">
      <div class="space-y-10">
        {/* email */}
        <div>
          <span class={labelClass}>Email</span>
          <div class="flex items-center justify-between gap-3">
            <span class="flex min-w-0 items-center gap-3">
              <MailIcon class="size-4 shrink-0 text-muted" />
              <a href={`mailto:${meta.email}`} class="select-all truncate font-mono text-sm text-default underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent">
                {meta.email}
              </a>
            </span>
            <CopyButton text={meta.email} />
          </div>
        </div>

        {/* socials — ruled rows: icon only, handle + arrow on the right.
            aria-label = "<network> @handle": it must CONTAIN the visible
            handle (WCAG 2.5.3 label-in-name) or voice-control users
            saying "click @akibh" can't hit it */}
        <div>
          <span class={labelClass}>Elsewhere</span>
          <ul class="divide-y divide-line-subtle border-y border-line-subtle">
            {
              socials.map((s) => {
                const Icon = socialIcons[s.name];
                return (
                  <li>
                    <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} @${s.handle}`} class="group flex items-center justify-between gap-4 py-3">
                      <span class="flex items-center gap-3">
                        {Icon && <Icon class="size-6 text-muted transition-colors group-hover:text-accent" />}
                      </span>
                      <span class="flex items-center gap-3">
                        <span class="font-mono text-2xs text-muted">@{s.handle}</span>
                        <svg class="size-3 text-muted transition-all group-hover:translate-x-0.5 group-hover:text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" />
                        </svg>
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>

        {/* local time — live clock, instrument-panel detail */}
        <div>
          <span class={labelClass}>Local Time</span>
          <p class="flex items-baseline gap-2 font-mono text-sm text-default">
            <span class="size-1.5 translate-y-[-1px] rounded-full bg-emerald-500" aria-hidden="true"></span>
            <span id="contact-local-time">--:--</span>
            <span class="font-mono text-2xs text-muted">Dhaka, {meta.timezone}</span>
          </p>
        </div>
      </div>
    </aside>
  </div>
</SectionShell>

<script>
  /**
   * Contact form → /api/contact → private mailer Worker (service binding).
   *
   * WHY fetch+JSON INSTEAD OF A NATIVE FORM POST: the endpoint speaks
   * JSON only; a native <form> POST would send form-urlencoded and land
   * on a raw JSON page. JS submission also keeps the user on the page
   * with an inline status line.
   *
   * SECURITY MODEL (v3 — service binding): the browser path carries NO
   * secret. It posts SAME-ORIGIN (no CORS, no mailer URL anywhere in
   * the client); the Pages Function forwards it with Cloudflare's
   * CF-Connecting-IP header to the mailer over a binding. The mailer validates the fields,
   * checks the honeypot, applies a per-IP rate limit and verifies the
   * Turnstile token (secret + hostname check) before sending.
   *
   * ERROR TEXT: the mailer's `error` strings are written to be safe to
   * show ("Invalid email address", "Too many requests…"), so they are
   * shown verbatim. Network or non-JSON failures fall back to a generic line.
   *
   * TOKEN LIFECYCLE: Turnstile tokens are single-use and expire after
   * 300s, so after EVERY attempt (success or failure) the widget is
   * reset to mint a fresh token for the next submit.
   *
   * LOCAL TESTING: `astro dev` has no /api/contact (bindings exist only
   * in the Workers runtime). Build, then `npx wrangler pages dev` here
   * while the mailer runs `wrangler dev` too; see the mailer README.
   */
  declare global {
    interface Window {
      turnstile?: { reset: () => void };
    }
  }

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  if (form) {
    const btn = document.getElementById("contact-submit") as HTMLButtonElement;
    const status = document.getElementById("contact-status") as HTMLParagraphElement;
    const ENDPOINT = form.dataset.endpoint as string;

    // ── lazy Turnstile (note 8b): inject api.js once, on first need ──
    let turnstileRequested = false;
    const loadTurnstile = () => {
      if (turnstileRequested) return;
      turnstileRequested = true;
      nearObserver.disconnect();
      const s = document.createElement("script");
      s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
      s.async = true;
      document.head.append(s);
    };
    const nearObserver = new IntersectionObserver(
      (entries) => entries.some((e) => e.isIntersecting) && loadTurnstile(),
      { rootMargin: "600px 0px" }
    );
    nearObserver.observe(form);
    form.addEventListener("focusin", loadTurnstile, { once: true });

    const label = btn.querySelector("[data-label]") as HTMLSpanElement;
    const IDLE_LABEL = label.textContent ?? "Send message";

    // literal class lookup — Tailwind only generates utilities it can
    // see verbatim in source, never build them by interpolation
    const tones = { idle: "text-muted", ok: "text-default", err: "text-accent" } as const;
    let statusTimer = 0;
    const setStatus = (msg: string, tone: keyof typeof tones) => {
      clearTimeout(statusTimer);
      status.textContent = msg;
      status.className = `min-h-4 font-mono text-2xs transition-opacity duration-500 sm:text-right ${tones[tone]}`;
    };
    // receipts are transient: fade out after `ms`, then clear the text
    const fadeStatus = (ms: number) => {
      statusTimer = window.setTimeout(() => {
        status.classList.add("opacity-0");
        statusTimer = window.setTimeout(() => setStatus("", "idle"), 500);
      }, ms);
    };

    type State = "idle" | "sending" | "sent" | "error";
    let timers: number[] = [];
    const clearTimers = () => (timers.forEach(clearTimeout), (timers = []));
    const setState = (state: State, text = IDLE_LABEL) => {
      clearTimers();
      btn.dataset.state = state;
      btn.setAttribute("aria-disabled", String(state === "sending" || state === "sent"));
      form.setAttribute("aria-busy", String(state === "sending"));
      label.textContent = text;
    };

    /* sending stages — the label walks through them while the request is
       in flight (see note 7c); times are from the measured flow */
    const STAGES: [number, string][] = [
      [0, "Verifying…"],
      [700, "Sending…"],
      [2600, "Delivering…"],
      [6500, "Almost there…"],
    ];
    const startSending = () => {
      setState("sending", STAGES[0][1]);
      timers = STAGES.slice(1).map(([at, text]) => window.setTimeout(() => (label.textContent = text), at));
    };

    type Result = { ok: true } | { ok: false; error: string };
    const post = async (payload: Record<string, string>): Promise<Result> => {
      const res = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const json: { success?: boolean; error?: string } = await res.json().catch(() => ({}));
      return res.ok && json.success
        ? { ok: true }
        : { ok: false, error: json.error ?? "Couldn't send — try again, or email me directly." };
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      loadTurnstile(); // no-op once loaded; covers a submit before it was needed
      if (btn.dataset.state === "sending" || btn.dataset.state === "sent") return; // no double submits
      const data = new FormData(form);

      // honeypot: a filled "website" means bot — fake success, send nothing
      if (data.get("website")) {
        form.reset();
        setStatus("✓ Message sent — I'll get back to you soon.", "ok");
        fadeStatus(7000);
        return;
      }

      const turnstileToken = String(data.get("cf-turnstile-response") ?? "");
      if (!turnstileToken) {
        setStatus("Human check is still loading — one moment, then retry.", "err");
        return;
      }

      const name = String(data.get("name") ?? "").trim().slice(0, 200);
      const email = String(data.get("email") ?? "").trim();
      const message = String(data.get("message") ?? "").trim().slice(0, 5000);

      startSending();
      setStatus("", "idle");
      let result: Result;
      try {
        result = await post({
          name,
          email,
          subject: `Portfolio contact — ${name}`, // optional per spec; aids inbox triage
          message,
          turnstileToken,
          website: "", // honeypot stays empty for humans
        });
      } catch {
        result = { ok: false, error: "Network error — try again, or email me directly." };
      } finally {
        window.turnstile?.reset(); // tokens are single-use — mint a fresh one
      }

      if (result.ok) {
        form.reset();
        setState("sent", "Sent");
        const at = new Intl.DateTimeFormat(undefined, { hour: "2-digit", minute: "2-digit" }).format(new Date());
        setStatus(`✓ Delivered at ${at}. I'll reply to ${email}.`, "ok");
        fadeStatus(7000);
        timers.push(window.setTimeout(() => setState("idle"), 4500));
      } else {
        setState("error", "Try again");
        setStatus(`✗ ${result.error}`, "err");
        timers.push(window.setTimeout(() => setState("idle"), 2500));
      }
    });
  }
</script>

<script>
  /**
   * Live Dhaka clock — ticks every 30s (minute precision is enough).
   * Module script: bundled once, zero dependencies, no hydration cost.
   */
  const timeEl = document.getElementById("contact-local-time");
  if (timeEl) {
    const fmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Dhaka",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
    const tick = () => (timeEl.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  /* Send button states (note 7c). Transform/opacity/width only, so it
     stays cheap; every state reads from the button's data-state. */
  .send-icon svg {
    position: absolute;
    inset: 0;
    transition: opacity 0.2s, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .send-spin,
  .send-check {
    opacity: 0;
  }
  .send-btn[data-state="idle"]:hover .send-arrow {
    transform: translateX(3px);
  }
  .send-btn[aria-disabled="true"] {
    cursor: progress;
  }

  /* sending: arrow flies out, spinner in, bar eases toward ~90% */
  .send-btn[data-state="sending"] .send-arrow {
    opacity: 0;
    transform: translateX(12px);
  }
  .send-btn[data-state="sending"] .send-spin {
    opacity: 1;
    animation: send-spin 0.8s linear infinite;
  }
  .send-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: rgb(255 255 255 / 0.8);
  }
  .send-btn[data-state="sending"] .send-bar {
    width: 90%;
    transition: width 8s cubic-bezier(0.08, 0.75, 0.2, 1);
  }

  /* sent: bar completes and fades, check draws, one ring pulse */
  .send-btn[data-state="sent"] .send-arrow {
    opacity: 0;
  }
  .send-btn[data-state="sent"] .send-check {
    opacity: 1;
  }
  .send-check path {
    stroke-dasharray: 22;
    stroke-dashoffset: 22;
  }
  .send-btn[data-state="sent"] .send-check path {
    animation: send-draw 0.45s ease-out 0.1s forwards;
  }
  .send-btn[data-state="sent"] .send-bar {
    width: 100%;
    opacity: 0;
    transition: width 0.3s ease-out, opacity 0.4s 0.7s;
  }
  .send-btn[data-state="sent"] {
    animation: send-ring 0.9s ease-out;
  }

  /* error: short shake */
  .send-btn[data-state="error"] {
    animation: send-shake 0.4s;
  }

  @keyframes send-spin {
    to { transform: rotate(360deg); }
  }
  @keyframes send-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes send-ring {
    from { box-shadow: 0 0 0 0 color-mix(in oklch, var(--ui-accent), transparent 40%); }
    to { box-shadow: 0 0 0 14px color-mix(in oklch, var(--ui-accent), transparent 100%); }
  }
  @keyframes send-shake {
    20%, 60% { transform: translateX(-4px); }
    40%, 80% { transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .send-btn,
    .send-btn * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    /* keep a static spinner visible instead of the spin */
    .send-btn[data-state="sending"] .send-spin {
      animation: none !important;
    }
  }
</style>
