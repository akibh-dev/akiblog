---
/**
 * @file sections/Projects.astro
 * @description Projects section — Astro owns the section shell + data,
 *              the interactive browser is the Base UI Tabs island.
 */
import SectionShell from "../ui/SectionShell.astro";
import ProjectBrowser from "../islands/ProjectBrowser";
import { portfolioData } from "../../data/portfolio";

const { projects, socials } = portfolioData;
const repoUrl = socials.find((s) => s.name === "GitHub")?.url;
---

{/* default pad: the ProjectWorkspace island has its own rounded frame
    (islands/projects/ProjectWorkspace.tsx) — full-bleed would collide
    with the panel's channel side lines */}
<SectionShell id="projects" index="02" label="Selected Work">
  <ProjectBrowser client:load projects={projects} repoUrl={repoUrl} />
</SectionShell>
