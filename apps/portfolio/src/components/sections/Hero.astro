---
/**
 * @file sections/Hero.astro
 * @description Hero — rotating quote epigraph, identity row with portrait
 *              frame, interactive shell, metric strip.
 *
 * POC / Implementation decisions:
 *
 * 1. RANDOM QUOTE (eyebrow slot, replaces "01. Identity"):
 *    The site is fully static, so a frontmatter-only random pick would be
 *    frozen at build time. Instead the SSR output renders one quote as the
 *    no-JS fallback, and a tiny module script (bottom of file) re-picks from
 *    `heroQuotes` on EVERY page load. `heroQuotes` is a standalone export in
 *    data/portfolio.ts so this script tree-shakes to a few strings rather
 *    than shipping the whole dataset to the browser.
 *
 * 2. PORTRAIT FRAME (right column):
 *    Placeholder drop-zone with an offset blueprint frame until a real photo
 *    is added — swap instructions are inline at the <figure> below.
 *
 * 3. REMOVED per request: status pill and the CTA row (View Projects /
 *    Get in Touch / CV). `meta.statusText` stays in the data file — it is
 *    still used by Layout.astro (meta description) and the Terminal.
 */
import SectionShell from "../ui/SectionShell.astro";
import ScrollRow from "../ui/ScrollRow.astro";
import Terminal from "../islands/terminal/Terminal.astro";
import { portfolioData, heroQuotes } from "../../data/portfolio";

const { meta, competitiveMetrics } = portfolioData;
const [first, ...rest] = meta.name.split(" ");

// Build-time fallback pick — ensures the slot is never empty without JS.
// The client script below re-randomizes on every page load.
const fallbackQuote = heroQuotes[Math.floor(Math.random() * heroQuotes.length)];
---

<SectionShell id="about" index="01" label="Identity">
  {/* rotating quote — occupies the eyebrow slot (see SectionShell) */}
  <p slot="header" class="min-w-0 font-display text-sm italic text-subtle md:text-base">
    <span class="text-accent" aria-hidden="true">&ldquo;</span><span id="hero-quote">{fallbackQuote}</span><span class="text-accent" aria-hidden="true">&rdquo;</span>
  </p>

  {/* identity row — name + one-liner left, portrait frame right */}
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_auto]">
    <div>
      {/* name — fluid scale */}
      <h1 class="font-display text-[clamp(2.5rem,6vw+0.5rem,4.5rem)] leading-[1.02] tracking-tight text-default">
        {first}
        <br />
        <span class="text-accent">{rest.join(" ")}</span>
      </h1>

      {/* one line only — no paragraph dump */}
      <p class="mt-5 max-w-xl font-display text-[clamp(1.05rem,1.2vw+0.9rem,1.35rem)] leading-relaxed text-subtle">
        I build resilient systems that live at the edge of the web.
      </p>
    </div>

    {/* ── Portrait frame ───────────────────────────────────────────────
        To add your photo: drop the file at public/images/portrait.jpg
        (served as /images/portrait.jpg), then replace the placeholder
        <div> below with:

        <img
          src="/images/portrait.jpg"
          alt="Portrait of Md Akib Hasan"
          class="aspect-[4/5] w-full object-cover"
        />
        ──────────────────────────────────────────────────────────────── */}
    <figure class="relative mx-auto w-56 sm:w-64 lg:mx-0 lg:w-72 lg:justify-self-end">
      {/* offset sheet behind — blueprint double-frame */}
      <div aria-hidden="true" class="absolute inset-0 translate-x-3 translate-y-3 rounded-sm border border-line-subtle"></div>
      <div class="relative aspect-[4/5] overflow-hidden rounded-sm border border-line bg-surface">
        {/* placeholder drop-zone (replaced by the <img> above) */}
        <div class="absolute inset-3 flex flex-col items-center justify-center gap-2 border border-dashed border-line-subtle text-center">
          <span class="font-mono text-2xs uppercase tracking-widest text-muted">Portrait</span>
          <span class="px-4 font-mono text-2xs leading-relaxed text-muted">
            add photo at<br />public/images/portrait.jpg
          </span>
        </div>
      </div>
    </figure>
  </div>

  {/* interactive shell — the hero centerpiece, centered */}
  <div class="mx-auto mt-12 max-w-2xl">
    <Terminal data={portfolioData} />
  </div>

  {/* metric strip */}
  <ScrollRow label="Competitive programming metrics" class="mt-10">
    {
      competitiveMetrics.map((m) => (
        <a
          href={m.url}
          target="_blank"
          rel="noopener noreferrer"
          class="w-[min(12rem,58vw)] shrink-0 snap-start rounded-md border border-line-subtle bg-surface px-5 py-4 transition-colors hover:border-accent hover:bg-accent-subtle"
        >
          <span class="mb-1 block font-mono text-2xs uppercase tracking-wider text-muted">{m.platform}</span>
          <span class="block font-mono text-base font-medium text-default">{m.stats}</span>
        </a>
      ))
    }
  </ScrollRow>
</SectionShell>

<script>
  /**
   * Random quote picker — runs on every page load (module script).
   * Swaps the SSR fallback for a fresh random entry from heroQuotes.
   */
  import { heroQuotes } from "../../data/portfolio";

  const el = document.getElementById("hero-quote");
  if (el && heroQuotes.length > 0) {
    el.textContent = heroQuotes[Math.floor(Math.random() * heroQuotes.length)];
  }
</script>
