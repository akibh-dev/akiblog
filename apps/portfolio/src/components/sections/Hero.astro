---
/* For more details, see docs/portfolio/implementation-notes.md#src-components-sections-hero-astro-note-1. */
import { Picture } from "astro:assets";
import SectionShell from "../ui/SectionShell.astro";
import myPic from "../../assets/my-pic.png";
import { portfolioData, heroQuotes } from "../../data/portfolio";

const { meta } = portfolioData;
const [first, ...rest] = meta.name.split(" ");

// Build-time fallback pick — ensures the slot is never empty without JS.
// The client script below re-randomizes on every page load.
const fallbackQuote = heroQuotes[Math.floor(Math.random() * heroQuotes.length)];
---

<SectionShell id="home" pad="p-0">
  <div class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,17rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,21rem)]">
    {/* ── left: eyebrow quote + identity ── */}
    <div class="flex flex-col justify-center py-10 md:py-14">
      <p class="flex items-center gap-4 font-display text-sm leading-relaxed text-subtle italic md:text-base">
        <span aria-hidden="true" class="h-px w-5 shrink-0 bg-line md:w-8"></span>
        <span class="min-w-0">
          <span class="text-accent" aria-hidden="true">&ldquo;</span><span id="hero-quote">{fallbackQuote}</span><span class="text-accent" aria-hidden="true">&rdquo;</span>
        </span>
        <span aria-hidden="true" class="h-px min-w-6 flex-1 bg-line"></span>
      </p>

      <div class="px-5 pt-9 md:px-8 md:pt-11">
        <h1 class="font-display text-[clamp(2.5rem,6vw+0.5rem,4.5rem)] leading-[1.02] tracking-tight text-default">
          {first}
          <br />
          <span class="text-accent">{rest.join(" ")}</span>
        </h1>
        <p class="mt-5 max-w-xl font-display text-[clamp(1.05rem,1.2vw+0.9rem,1.35rem)] leading-relaxed text-subtle">
          I build resilient systems that live at the edge of the web.
        </p>
      </div>
    </div>

    {/* ── right: drafting panel with photo in the centre cell ── */}
    <div class="border-t border-line p-2.5 md:flex md:border-t-0 md:border-l">
      <figure class="relative mx-auto aspect-square max-w-80 border border-line md:aspect-auto md:w-full md:max-w-none md:flex-1">
        {/* hatched top/bottom bands — their inner edges are the horizontal construction lines */}
        <span aria-hidden="true" class="hatch absolute inset-x-0 top-0 h-[18%] border-b border-line"></span>
        <span aria-hidden="true" class="hatch absolute inset-x-0 bottom-0 h-[18%] border-t border-line"></span>
        {/* photo — fills the centre cell */}
        {/* clip box = the centre cell; the photo inside is zoomed toward
            the subject (see note 2b) without spilling over the bands */}
        <span class="absolute inset-x-[8%] inset-y-[18%] overflow-hidden">
          <Picture
            src={myPic}
            alt={`Portrait of ${meta.name}`}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[480, 640, 890]}
            sizes="(min-width: 48rem) 400px, 110vw"
            loading="eager"
            fetchpriority="high"
            class="size-full origin-[43%_58%] scale-[1.35] object-cover"
          />
        </span>
        {/* vertical construction lines — drawn last so they cross the bands and the photo edges */}
        <span aria-hidden="true" class="absolute inset-y-0 left-[8%] border-l border-line"></span>
        <span aria-hidden="true" class="absolute inset-y-0 right-[8%] border-r border-line"></span>
      </figure>
    </div>
  </div>
</SectionShell>

<script>
  /**
   * Random quote picker — runs on every page load (module script).
   * Swaps the SSR fallback for a fresh random entry from heroQuotes.
   */
  import { heroQuotes } from "../../data/portfolio";

  const el = document.getElementById("hero-quote");
  if (el && heroQuotes.length > 0) {
    el.textContent = heroQuotes[Math.floor(Math.random() * heroQuotes.length)];
  }
</script>

<style>
  .hatch {
    background-image: repeating-linear-gradient(45deg, var(--color-hatch) 0 1px, transparent 1px 6px);
  }
</style>
