---
/**
 * @file sections/Hero.astro
 * @description Improvised hero — designed, not dumped.
 *
 * Prose shrinks to a single confident line; the facts live inside a real
 * interactive shell (islands/terminal) — visitors can type `help`,
 * `projects`, `skills`, `theme dark`… Structure: status pill, name,
 * one-liner, CTA row, terminal, metric strip.
 */
import SectionShell from "../ui/SectionShell.astro";
import ScrollRow from "../ui/ScrollRow.astro";
import Terminal from "../islands/terminal/Terminal";
import { portfolioData } from "../../data/portfolio";

const { meta, competitiveMetrics } = portfolioData;
const [first, ...rest] = meta.name.split(" ");
---

<SectionShell id="about" index="01" label="Identity">
  {/* status pill — what I'm doing, not what I'm asking for */}
  <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-line-subtle bg-surface px-3.5 py-1.5 font-mono text-2xs text-subtle">
    <span class="relative flex size-2">
      <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
      <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
    </span>
    {meta.statusText}
  </div>

  {/* name — fluid scale */}
  <h1 class="font-display text-[clamp(2.5rem,6vw+0.5rem,4.5rem)] leading-[1.02] tracking-tight text-default">
    {first}
    <br />
    <span class="text-accent">{rest.join(" ")}</span>
  </h1>

  {/* one line only — no paragraph dump */}
  <p class="mt-5 max-w-xl font-display text-[clamp(1.05rem,1.2vw+0.9rem,1.35rem)] leading-relaxed text-subtle">
    I build resilient systems that live at the edge of the web.
  </p>

  {/* CTA row */}
  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a href="#projects" class="rounded-md bg-accent px-5 py-2.5 font-mono text-xs text-white transition-colors hover:bg-accent-hover">
      View Projects ↓
    </a>
    <a href="#contact" class="rounded-md border border-line-subtle bg-surface px-5 py-2.5 font-mono text-xs text-subtle transition-colors hover:border-accent hover:text-accent">
      Get in Touch
    </a>
    <a href={meta.resumeUrl} download class="px-3 py-2.5 font-mono text-xs text-muted transition-colors hover:text-accent">
      CV ↓
    </a>
  </div>

  {/* interactive shell — the hero centerpiece, centered */}
  <div class="mx-auto mt-12 max-w-2xl">
    <Terminal client:load data={portfolioData} />
  </div>

  {/* metric strip */}
  <ScrollRow label="Competitive programming metrics" class="mt-10">
    {
      competitiveMetrics.map((m) => (
        <a
          href={m.url}
          target="_blank"
          rel="noopener noreferrer"
          class="w-[min(12rem,58vw)] shrink-0 snap-start rounded-md border border-line-subtle bg-surface px-5 py-4 transition-colors hover:border-accent hover:bg-accent-subtle"
        >
          <span class="mb-1 block font-mono text-2xs uppercase tracking-wider text-muted">{m.platform}</span>
          <span class="block font-mono text-base font-medium text-default">{m.stats}</span>
        </a>
      ))
    }
  </ScrollRow>
</SectionShell>
