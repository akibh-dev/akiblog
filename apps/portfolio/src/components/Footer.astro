---
/**
 * @file apps/portfolio/src/components/Footer.astro
 * @description Generous contact section and technical footer inspired by Zed.dev.
 *
 * POC / Implementation Architecture:
 * - Fulfills requirement for a relatively big, comprehensive footer containing contact mechanisms.
 * - Houses both a direct minimalist contact form and an instant one-click email copy widget.
 * - Provides verified geographic coordinates, developer social links, and system deployment status.
 */

import { portfolioData } from '../data/portfolio';
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="pt-20 sm:pt-28 pb-12 bg-[#06070a] border-t border-neutral-800/90 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Top Contact Headline -->
    <div class="space-y-4 max-w-2xl mb-14">
      <div class="flex items-center gap-2 font-mono text-xs text-neutral-400">
        <span class="text-neutral-500">  </span>
        <span class="text-neutral-300 font-semibold uppercase tracking-wider">04. Transmission & Contact</span>
      </div>
      <p class="text-base sm:text-lg text-neutral-400 font-normal leading-relaxed">
        Have an engineering opportunity, a distributed systems challenge, or want to discuss edge architectures? Feel free to reach out.
      </p>
    </div>

    <!-- Contact Grid: Interactive Form + Direct Transmission Channels -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-20">
      <!-- Left Column: Direct Minimalist Contact Form -->
      <div class="lg:col-span-7 p-6 sm:p-8 rounded-2xl border border-neutral-800 bg-[#0a0b10] space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-neutral-850">
          <span class="font-mono text-xs text-neutral-400 uppercase tracking-wider">Direct Message</span>
          <span class="font-mono text-xs text-neutral-650">Formspree / HTTPS</span>
        </div>

        <form
          action={`https://formspree.io/f/mnjjnbkl`}
          method="POST"
          class="space-y-4 text-xs font-mono"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="name" class="text-neutral-400">Name / Handle</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ada Lovelace"
                class="w-full px-3.5 py-2.5 rounded-lg bg-neutral-900/90 border border-neutral-800 text-neutral-200 placeholder-neutral-600 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 outline-none transition-colors"
              />
            </div>
            <div class="space-y-1.5">
              <label for="email" class="text-neutral-400">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="ada@example.com"
                class="w-full px-3.5 py-2.5 rounded-lg bg-neutral-900/90 border border-neutral-800 text-neutral-200 placeholder-neutral-600 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 outline-none transition-colors"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="message" class="text-neutral-400">Transmission Payload (Message)</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Tell me about the system, timeline, or idea..."
              class="w-full px-3.5 py-2.5 rounded-lg bg-neutral-900/90 border border-neutral-800 text-neutral-200 placeholder-neutral-600 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 outline-none transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto px-6 py-2.5 bg-neutral-100 hover:bg-white text-neutral-950 font-semibold rounded-lg font-mono text-xs transition-colors flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Message</span>
            <span>→</span>
          </button>
        </form>
      </div>

      <!-- Right Column: Direct Email, Location & Socials -->
      <div class="lg:col-span-5 space-y-6">
        <!-- One-Click Email Copy Card -->
        <div class="p-6 rounded-2xl border border-neutral-800 bg-[#0a0b10] space-y-4">
          <span class="font-mono text-xs text-neutral-400 uppercase tracking-wider block">Direct Email</span>
          <div class="flex items-center justify-between gap-3 p-3 rounded-lg bg-neutral-900 border border-neutral-800 font-mono text-xs">
            <span id="email-text" class="text-neutral-200 select-all">{portfolioData.meta.email}</span>
            <button
              id="copy-email-btn"
              type="button"
              class="px-2.5 py-1 text-[11px] bg-neutral-800 hover:bg-neutral-700 text-neutral-300 rounded border border-neutral-700 transition-all cursor-pointer"
              title="Copy to clipboard"
            >
              Copy
            </button>
          </div>
        </div>

        <!-- Social Network Links Grid -->
        <div class="p-6 rounded-2xl border border-neutral-800 bg-[#0a0b10] space-y-3 font-mono text-xs">
          <span class="text-neutral-400 uppercase tracking-wider block">Network Nodes</span>
          <div class="grid grid-cols-2 gap-2">
            {portfolioData.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2.5 rounded-lg border border-neutral-850 bg-neutral-900/60 hover:border-neutral-700 hover:bg-neutral-800/40 text-neutral-300 hover:text-white transition-all flex items-center justify-between no-underline"
              >
                <span>{social.name}</span>
                <span class="text-neutral-500">↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom System Status & Copyright Bar -->
    <div class="pt-8 border-t border-neutral-850 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-neutral-500">
      <div>
        © {currentYear} {portfolioData.meta.name}. Minimalist standalone portfolio.
      </div>
      <div class="flex items-center gap-3 text-neutral-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-[11px]">Cloudflare Edge Workers • 0-egress CDN</span>
      </div>
    </div>
  </div>
</footer>

<script>
  // One-click copy email functionality with instantaneous visual feedback
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-text');

  if (copyBtn && emailText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailText.textContent?.trim() || '');
        const originalText = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        copyBtn.classList.add('text-emerald-400', 'border-emerald-700');
        setTimeout(() => {
          copyBtn.textContent = originalText;
          copyBtn.classList.remove('text-emerald-400', 'border-emerald-700');
        }, 2000);
      } catch (err) {
        console.error('Clipboard copy failed:', err);
      }
    });
  }
</script>
