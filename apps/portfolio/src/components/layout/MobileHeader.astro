---
/**
 * @file layout/MobileHeader.astro
 * @description Mobile top bar (below md); navigation lives in the
 *              MobileMenu island (pure Astro, native <dialog> — focus trap,
 *              Esc, backdrop dismiss come from the platform).
 *
 * RESUME BUTTON: the desktop sidebar keeps the résumé download always in
 * view, but on phones it was only reachable after opening the menu. The
 * primary recruiter CTA now sits in the bar itself, beside Menu, styled as
 * the same `btn` chip so the two read as one control group. Plain <a
 * download> (same-origin PDF) — zero JS. Label "CV" keeps the chip short
 * next to the brand on 320px screens; the full name is in aria-label/title.
 *
 * POC: <MobileHeader /> — rendered once by the layout, hidden from md up.
 */
import { portfolioData } from "../../data/portfolio";
import MobileMenu from "../islands/MobileMenu.astro";
import BrandLogo from "./BrandLogo.astro";
import { ResumeIcon } from "../../icons";
---

<header class="fixed inset-x-0 top-[var(--site-inset-top)] z-40 mx-3 flex h-[var(--site-header-height)] items-center justify-between rounded-md border border-line-subtle bg-surface px-3 md:hidden">
  <a href="#top" class="flex items-center gap-2">
    <BrandLogo class="size-7" />
    <span class="font-mono text-sm font-medium text-default">{portfolioData.meta.handle}</span>
  </a>

  <div class="flex items-center gap-2">
    <a
      href={portfolioData.meta.resumeUrl}
      download
      title="Download resume (PDF)"
      aria-label="Download resume (PDF)"
      class="btn group flex items-center gap-1.5 rounded-md px-3 py-1.5 font-mono text-2xs text-subtle"
    >
      <ResumeIcon class="size-3.5 text-muted transition-colors group-hover:text-accent" />
      CV
    </a>
    <MobileMenu />
  </div>
</header>
