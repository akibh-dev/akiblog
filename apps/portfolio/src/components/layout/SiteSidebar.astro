---
/**
 * @file layout/SiteSidebar.astro
 * @description Desktop sidebar — on delta.dev the sidebar IS the header.
 *
 * Pure Astro composition: markup is declarative; the only interactivity
 * (scroll-spy, theme) is slotted in as self-contained custom elements.
 * The tree line doubles as a CSS scroll-progress indicator (zero JS).
 */
import { portfolioData } from "../../data/portfolio";
import ThemeSwitch from "../islands/ThemeSwitch";
import ScrollSpy from "../islands/ScrollSpy.astro";

const sections = [
  { id: "about", label: "About", number: "01" },
  { id: "projects", label: "Projects", number: "02" },
  { id: "writings", label: "Writings", number: "03" },
  { id: "skills", label: "Skills", number: "04" },
  { id: "contact", label: "Contact", number: "05" },
];
---

<aside class="sticky top-[var(--site-content-top)] z-40 hidden h-[calc(100dvh-var(--site-content-top)-var(--site-content-bottom))] md:block">
  <div class="flex h-full flex-col border-r border-line-subtle px-5 py-6">
    {/* brand */}
    <a href="#top" class="group mb-8 flex items-center gap-2.5">
      <span class="flex size-8 items-center justify-center rounded-md border border-line-subtle bg-surface transition-colors group-hover:border-accent">
        <span class="font-mono text-xs font-semibold text-accent">Δ</span>
      </span>
      <span class="font-mono text-sm leading-tight">
        <span class="block font-medium text-default">{portfolioData.meta.handle}</span>
        <span class="block text-2xs text-muted">.dev</span>
      </span>
    </a>

    {/* tree nav with scroll-progress branch */}
    <ScrollSpy>
      <nav aria-label="Sections" class="relative flex-1">
        <div aria-hidden="true" class="absolute top-1 bottom-1 left-[5px] w-px bg-line-subtle"></div>
        <div aria-hidden="true" class="scroll-progress absolute top-1 bottom-1 left-[5px] w-px bg-accent"></div>

        <ul class="relative space-y-0.5">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="nav-link group flex items-center gap-3 rounded-md py-2 pr-2 text-subtle transition-colors hover:text-default">
                  <span class="nav-node size-[11px] rounded-full border-2 border-line bg-canvas transition-colors"></span>
                  <span class="font-mono text-xs">
                    <span class="mr-1.5 text-muted">{s.number}.</span>
                    {s.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </ScrollSpy>

    {/* socials */}
    <div class="mt-6 space-y-0.5 border-t border-line-subtle pt-5">
      {
        portfolioData.socials.slice(0, 3).map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between rounded-md px-1 py-1.5 font-mono text-2xs text-muted transition-colors hover:text-accent">
            {s.name}
            <svg class="size-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        ))
      }
    </div>

    {/* theme + copyright */}
    <div class="mt-5 border-t border-line-subtle pt-4">
      <ThemeSwitch client:load />
      <p class="mt-4 font-mono text-[9px] text-muted">© {new Date().getFullYear()} {portfolioData.meta.name}</p>
    </div>
  </div>
</aside>
