---
/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-1. */
import { portfolioData } from "../../data/portfolio";
import { sections } from "../../data/sections";
import ThemeSwitch from "../islands/ThemeSwitch.astro";
import ScrollSpy from "../islands/ScrollSpy.astro";
import BrandLogo from "./BrandLogo.astro";
import { GitHubIcon, LinkedInIcon, XIcon, FileTextIcon, RssIcon } from "../../icons";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

/* Social rows carry their brand glyph from the canonical icon set
   (src/icons/social/) next to the name; keyed by portfolioData name. */
const SOCIAL_ICONS: Record<string, AstroComponentFactory> = {
  GitHub: GitHubIcon,
  LinkedIn: LinkedInIcon,
  X: XIcon,
};

/* stations come from the single nav registry (data/sections.ts) */

/* Rail geometry — derivation documented under GEOMETRY above. */
const SPINE_TOP = 14; // top-3.5 = top edge of the first station node
const ROW_H = 34;     // anchor height: py-1.5 (12) + 22px label
const ROW_GAP = 4;    // space-y-1
const TREE_TOP = sections.length * ROW_H + (sections.length - 1) * ROW_GAP + 4; // N=6: stations (224) + mt-1 (4) = 228
---

{/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-2. */}
<div class="pointer-events-none fixed inset-0 z-30 hidden grid-cols-[var(--site-page-left)_minmax(0,1fr)_var(--site-page-right)] grid-rows-[var(--site-frame-top)_minmax(0,1fr)] md:grid">
<div class="col-start-2 row-start-2 grid min-h-0 min-w-0 grid-cols-(--site-columns)">
<aside class="pointer-events-auto col-start-1 row-start-1 h-[calc(100dvh-var(--site-frame-top)-var(--site-content-bottom))] self-start border-line border-x bg-surface">

  {/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-3. */}
  <div class="flex h-full flex-col px-5 py-6">
    {/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-4. */}
    <a href="#top" class="group mb-8 block">
      <span class="flex flex-col items-start gap-2 lg:flex-row lg:items-center lg:gap-3">
        <BrandLogo class="size-14 shrink-0 transition-transform duration-300 ease-out motion-safe:group-hover:scale-105 motion-reduce:transition-none" />
        <span class="min-w-0 leading-tight">
          <span class="block font-display text-xl text-default">{portfolioData.meta.handle}</span>
          <span class="block font-mono text-2xs text-muted">.dev</span>
        </span>
      </span>
    </a>

    {/* tree nav: commit-graph stations + scroll-progress branch */}
    <ScrollSpy>
      <nav aria-label="Sections" class="relative flex flex-1 flex-col">
        {/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-5. */}
        <svg aria-hidden="true" class="pointer-events-none absolute inset-0 size-full">
          <defs>
            <pattern id="git-tree" width="100%" height="760" patternUnits="userSpaceOnUse" patternTransform={`translate(0 ${TREE_TOP})`}>
              {/* branches — 1.2px, forking RIGHT off the trunk in the
                  reference waterfall (28.5→53.5→…→153.5). NO trunk here:
                  the single <line> below is the only trunk paint. */}
              <g style="stroke: var(--ui-border-subtle); stroke-width: 1.2; stroke-linejoin: round; fill: none">
                <path d="M3.5 60 L28.5 80 V700 L3.5 720" />
                <path d="M28.5 120 L53.5 140 V660 L28.5 680" />
                <path d="M53.5 180 L78.5 200 V620 L53.5 640" />
                <path d="M78.5 240 L103.5 260 V580 L78.5 600" />
                <path d="M103.5 300 L128.5 320 V540 L103.5 560" />
                <path d="M128.5 360 L153.5 380 V500 L128.5 520" />
              </g>
              {/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-6. */}
              <g style="stroke: var(--ui-border); stroke-width: 1; fill: var(--ui-canvas)">
                {/* trunk (60 = branch-1 fork, 720 = branch-1 merge) */}
                <circle cx="3.5" cy="20" r="3" /><circle cx="3.5" cy="60" r="3" /><circle cx="3.5" cy="110" r="3" /><circle cx="3.5" cy="160" r="3" /><circle cx="3.5" cy="230" r="3" /><circle cx="3.5" cy="290" r="3" /><circle cx="3.5" cy="350" r="3" /><circle cx="3.5" cy="410" r="3" /><circle cx="3.5" cy="470" r="3" /><circle cx="3.5" cy="530" r="3" /><circle cx="3.5" cy="590" r="3" /><circle cx="3.5" cy="650" r="3" /><circle cx="3.5" cy="720" r="3" />
                {/* branch 1 (120 = branch-2 fork, 680 = branch-2 merge) */}
                <circle cx="28.5" cy="80" r="3" /><circle cx="28.5" cy="120" r="3" /><circle cx="28.5" cy="180" r="3" /><circle cx="28.5" cy="250" r="3" /><circle cx="28.5" cy="330" r="3" /><circle cx="28.5" cy="410" r="3" /><circle cx="28.5" cy="490" r="3" /><circle cx="28.5" cy="570" r="3" /><circle cx="28.5" cy="640" r="3" /><circle cx="28.5" cy="680" r="3" /><circle cx="28.5" cy="700" r="3" />
                {/* branch 2 (180 = branch-3 fork, 640 = branch-3 merge) */}
                <circle cx="53.5" cy="140" r="3" /><circle cx="53.5" cy="180" r="3" /><circle cx="53.5" cy="250" r="3" /><circle cx="53.5" cy="330" r="3" /><circle cx="53.5" cy="410" r="3" /><circle cx="53.5" cy="490" r="3" /><circle cx="53.5" cy="570" r="3" /><circle cx="53.5" cy="640" r="3" />
                {/* branch 3 (240 = branch-4 fork, 600 = branch-4 merge) */}
                <circle cx="78.5" cy="200" r="3" /><circle cx="78.5" cy="240" r="3" /><circle cx="78.5" cy="310" r="3" /><circle cx="78.5" cy="390" r="3" /><circle cx="78.5" cy="470" r="3" /><circle cx="78.5" cy="550" r="3" /><circle cx="78.5" cy="600" r="3" />
                {/* branch 4 (300 = branch-5 fork, 560 = branch-5 merge) */}
                <circle cx="103.5" cy="260" r="3" /><circle cx="103.5" cy="300" r="3" /><circle cx="103.5" cy="370" r="3" /><circle cx="103.5" cy="450" r="3" /><circle cx="103.5" cy="530" r="3" /><circle cx="103.5" cy="560" r="3" />
                {/* branch 5 (360 = branch-6 fork, 520 = branch-6 merge) */}
                <circle cx="128.5" cy="320" r="3" /><circle cx="128.5" cy="360" r="3" /><circle cx="128.5" cy="430" r="3" /><circle cx="128.5" cy="520" r="3" />
                {/* branch 6 — deepest, shortest */}
                <circle cx="153.5" cy="380" r="3" /><circle cx="153.5" cy="450" r="3" /><circle cx="153.5" cy="500" r="3" />
              </g>
            </pattern>
          </defs>
          {/* trunk — painted ONCE from the first station (top-3.5) to the
              sidebar bottom; y2="100%" resolves against the nav viewport. */}
          <line x1="3.5" y1={SPINE_TOP} x2="3.5" y2="100%" style="stroke: var(--ui-border-subtle); stroke-width: 1.2" />
          {/* git tree — branches + commits only, starting below the last
              station; the SVG viewport clips the rect at the nav bottom. */}
          <rect x="0" y={TREE_TOP} width="100%" height="100%" fill="url(#git-tree)" />
        </svg>

        {/* stations */}
        <div class="relative">
          {/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-7. */}
          <div aria-hidden="true" data-station-link class="absolute left-[3px] w-[1.2px] bg-accent transition-[top,height] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none" style="top: 17px; height: 0"></div>

        <ul class="relative space-y-1">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="group flex items-center gap-3 py-1.5">
                  {/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-8. */}
                  <span data-station-node class="size-[7px] shrink-0 rounded-full border border-line bg-canvas transition-[transform,background-color,border-color] duration-200 group-aria-[current=true]:scale-[1.4] group-aria-[current=true]:border-accent group-aria-[current=true]:bg-accent motion-reduce:transition-none"></span>
                  {/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-9. */}
                  <span
                    class="rounded border border-transparent px-2 py-0.5 font-mono text-2xs font-semibold uppercase tracking-[0.18em] text-subtle transition-colors duration-200 group-hover:btn-hover group-aria-[current=true]:border-accent group-aria-[current=true]:text-accent group-aria-[current=true]:group-hover:text-accent"
                  >
                    {s.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        </div>

        {/* tree-zone spacer — preserves the old mt-1 min-h-8 flex-1 layout;
            the rail SVG paints the infinite tree through this space */}
        <div aria-hidden="true" class="mt-1 min-h-8 flex-1"></div>
      </nav>
    </ScrollSpy>

    {/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-10. */}
    <div class="mt-6 border-t border-line-subtle pt-5">
      {/* resume — `download` works same-origin (public/akib_s_resume.pdf); the
          down-arrow is drawn inline (the icon set has no download glyph)
          so it inherits the same muted→accent hover as FileTextIcon. */}
      <a
        href={portfolioData.meta.resumeUrl}
        download
        title="Download resume (PDF)"
        aria-label="Download resume (PDF)"
        class="group flex items-center justify-between"
      >
        <span class="flex items-center gap-2">
          <FileTextIcon class="size-4 text-muted transition-colors group-hover:text-accent" />
          <span class="font-mono text-2xs uppercase tracking-wider text-subtle transition-colors group-hover:text-accent">Resume</span>
        </span>
        <svg class="size-3.5 text-muted transition-all group-hover:translate-y-0.5 group-hover:text-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 4v11m0 0 4-4m-4 4-4-4" />
          <path d="M5 19h14" />
        </svg>
      </a>

      {/* For more details, see docs/portfolio/implementation-notes.md#src-components-layout-sitesidebar-astro-note-11. */}
      <div class="mt-4 flex items-center gap-0.5 lg:gap-1.5">
        {
          [
            ...portfolioData.socials.slice(0, 3).map((s) => ({ name: s.name, url: s.url, Icon: SOCIAL_ICONS[s.name] })),
            { name: "RSS feed", url: `${portfolioData.meta.blogUrl}/rss.xml`, Icon: RssIcon },
          ].map(({ name, url, Icon }) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              title={name}
              aria-label={name}
              class="flex size-6 items-center justify-center rounded-md text-muted transition-colors hover:text-accent lg:size-7"
            >
              {Icon && <Icon class="size-5" />}
            </a>
          ))
        }
      </div>
    </div>

    {/* theme + copyright */}
    <div class="mt-3 pt-2">
      <ThemeSwitch />
      <p class="mt-4 font-mono text-[9px] text-muted">&#x24B6; {new Date().getFullYear()} {portfolioData.meta.name}</p>
    </div>
  </div>
</aside>
</div>
</div>
