---
/* For more details, see docs/portfolio/implementation-notes.md#src-components-islands-projects-chrome-chromebutton-astro-note-1. */
interface Props {
  label: string; // tooltip + accessible name
  class?: string;
  disabled?: boolean;
  pressed?: boolean;
  [key: string]: unknown; // data-* hooks forwarded to the button
}
const { label, class: className = "", disabled = false, pressed, ...rest } = Astro.props;
// caller controls display when it hides the button (see RESPONSIVE HIDING)
const display = /(^|\s)hidden(\s|$)/.test(className) ? "" : "inline-flex";
---

<button
  type="button"
  title={label}
  aria-label={label}
  aria-pressed={pressed}
  disabled={disabled}
  class={`${display} size-6 shrink-0 items-center justify-center rounded-sm leading-none text-muted outline-none transition-colors hover:bg-control-hover hover:text-default focus-visible:bg-control-hover disabled:pointer-events-none disabled:opacity-40 ${
    pressed ? "bg-control-hover/60 text-default" : ""
  } ${className}`}
  {...rest}
>
  <slot />
</button>
