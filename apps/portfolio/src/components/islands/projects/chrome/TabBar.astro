---
/* For more details, see docs/portfolio/implementation-notes.md#src-components-islands-projects-chrome-tabbar-astro-note-1. */
import {
  ArrowLeftIcon,
  ArrowRightIcon,
  FileTextIcon,
  MaximizeIcon,
  PlusIcon,
  SplitPaneIcon,
  CloseIcon,
} from "../../../../icons";
import ChromeButton from "./ChromeButton.astro";
import { STATUS_META, type ProjectFile } from "../types";

interface Props {
  files: ProjectFile[];
}
const { files } = Astro.props;
const firstId = files[0]?.id;
---

<div data-tabbar class="flex h-9 shrink-0 items-stretch border-b border-line-subtle">
  {/* buffer history — wired to the workspace's navigation deque;
      disabled at the start/end of the deque */}
  <div class="flex items-center gap-0.5 border-r border-line-subtle px-1.5">
    <ChromeButton label="Go back" disabled data-back>
      <ArrowLeftIcon class="size-3" />
    </ChromeButton>
    <ChromeButton label="Go forward" disabled data-forward>
      <ArrowRightIcon class="size-3" />
    </ChromeButton>
  </div>

  {/* open buffers */}
  <div aria-label="Open buffers" class="no-scrollbar flex min-w-0 flex-1 items-stretch overflow-x-auto">
    {
      files.map((file) => {
        const isActive = file.id === firstId;
        const meta = STATUS_META[file.status];
        return (
          <div
            data-tab={file.id}
            {...(meta.dirty ? { "data-dirty": "1" } : {})}
            hidden={!isActive}
            class={`group flex min-w-0 shrink-0 items-center gap-1.5 border-r border-line-subtle pr-1.5 pl-3 font-mono text-xs transition-colors ${
              isActive
                ? "bg-canvas text-default"
                : "text-muted hover:bg-control-hover/40 hover:text-subtle"
            }`}
          >
            {/* tab body — focuses the buffer */}
            <button
              type="button"
              data-tab-body={file.id}
              aria-current={isActive}
              title={file.file}
              class="flex min-w-0 items-center gap-2 py-1 outline-none"
            >
              <FileTextIcon class="size-3 shrink-0 text-muted" />
              <span class="truncate">{file.file}</span>
              {meta.dirty && (
                <span
                  role="img"
                  aria-label={`status: ${meta.label}`}
                  class={`size-1.5 shrink-0 rounded-full ${meta.dotClass}`}
                />
              )}
            </button>

            {/* close */}
            <button
              type="button"
              data-tab-close={file.id}
              aria-label={`Close ${file.file}`}
              class="rounded-sm p-0.5 text-muted outline-none transition-colors hover:bg-control-hover hover:text-default focus-visible:bg-control-hover"
            >
              <CloseIcon class="size-3" />
            </button>
          </div>
        );
      })
    }
  </div>

  {/* pane actions — actionless for now */}
  <div class="hidden items-center gap-0.5 border-l border-line-subtle px-1.5 sm:flex">
    <ChromeButton label="New file">
      <PlusIcon class="size-3" />
    </ChromeButton>
    <ChromeButton label="Split pane">
      <SplitPaneIcon class="size-3" />
    </ChromeButton>
    <ChromeButton label="Fullscreen">
      <MaximizeIcon class="size-3" />
    </ChromeButton>
  </div>
</div>
