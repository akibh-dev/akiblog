---
/* For more details, see docs/portfolio/implementation-notes.md#src-components-islands-projects-chrome-menubar-astro-note-1. */
import { Image } from "astro:assets";
import myPic from "../../../../assets/my-pic.png";

const MENUS = ["Zed", "File", "Edit", "Selection", "Go", "Run", "Window", "Help"];
const USER_MENU_ITEMS = ["Settings", "Keymap", "Themes", "Icon Themes", "Extensions"];

const ITEM_CLASS =
  "flex cursor-default select-none items-center rounded-sm px-2.5 py-1.5 font-mono text-xs text-subtle outline-none";
---

<div class="flex h-8 shrink-0 items-center gap-0.5 border-b border-line-subtle px-2 font-mono text-xs">
  {
    MENUS.map((m, i) => (
      <button
        type="button"
        class={`rounded-sm px-2 py-1 outline-none transition-colors hover:bg-control-hover focus-visible:bg-control-hover ${
          i === 0 ? "font-medium text-default" : "text-muted hover:text-subtle"
        } ${i >= 3 ? "hidden sm:block" : ""}`}
      >
        {m}
      </button>
    ))
  }

  {/* user avatar — the one WORKING menu (items still actionless) */}
  <div class="relative ml-auto">
    <button
      type="button"
      data-menu-trigger
      aria-haspopup="menu"
      aria-expanded="false"
      aria-label="AH, user menu"
      title="User menu"
      class="relative flex size-6 items-center justify-center overflow-hidden rounded-full bg-accent-subtle font-mono text-[9px] font-medium text-accent outline-none ring-line transition-shadow hover:ring-2 focus-visible:ring-2"
    >
      <span aria-hidden="true">AH</span>
      <Image
        data-avatar-img
        src={myPic}
        alt=""
        width={48}
        height={48}
        format="webp"
        class="absolute inset-0 size-full object-cover object-[45%_40%]"
      />
    </button>

    <div
      data-menu-popup
      role="menu"
      aria-label="User menu"
      hidden
      class="absolute right-0 top-[calc(100%+6px)] z-50 min-w-44 rounded-md border border-line-subtle bg-surface p-1 shadow-lg"
    >
      {
        USER_MENU_ITEMS.map((item) => (
          <div role="menuitem" tabindex="-1" data-menu-item class={ITEM_CLASS}>
            {item}
          </div>
        ))
      }
      <div role="separator" class="mx-1 my-1 h-px bg-line-subtle"></div>
      <div role="menuitem" tabindex="-1" data-menu-item class={ITEM_CLASS}>
        Sign Out
      </div>
    </div>
  </div>
</div>
