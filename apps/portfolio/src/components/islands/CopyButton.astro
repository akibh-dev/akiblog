---
/* For more details, see docs/portfolio/implementation-notes.md#src-components-islands-copybutton-astro-note-1. */
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<copy-button class="contents" data-text={text}>
  <button
    type="button"
    data-ok="false"
    class="btn rounded-sm px-3 py-1.5 font-mono text-2xs data-[ok=true]:btn-hover data-[ok=true]:text-accent"
  >
    Copy
  </button>
</copy-button>

<script>
  class CopyButton extends HTMLElement {
    private timer?: ReturnType<typeof setTimeout>;

    connectedCallback() {
      const btn = this.querySelector("button");
      if (!btn) return;

      btn.addEventListener("click", async () => {
        let label = "Failed";
        try {
          await navigator.clipboard.writeText(this.dataset.text ?? "");
          label = "Copied!";
        } catch {
          /* clipboard blocked (permissions / insecure context) → "Failed" */
        }
        btn.textContent = label;
        btn.dataset.ok = String(label === "Copied!");

        clearTimeout(this.timer);
        this.timer = setTimeout(() => {
          btn.textContent = "Copy";
          btn.dataset.ok = "false";
        }, 2000);
      });
    }
  }

  customElements.define("copy-button", CopyButton);
</script>
