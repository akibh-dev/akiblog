---
/* For more details, see docs/portfolio/implementation-notes.md#src-components-ui-versecalligraphy-astro-note-1. */

/* 2:269 — normalized for the Square Kufic cmap (see note 2);
   geometric 4-line split (see note 4). Full text in aria-label for AT. */
const line1 = "يُؤْتِى الْحِكْمَةَ مَن يَشَآءُ";
const line2 = "وَمَن يُؤْتَ الْحِكْمَةَ فَقَدْ";
const line3 = "أُوتِىَ خَيْرًا كَثِيرًا وَمَا";
const line4 = "يَذَّكَّرُ إِلَّآ أُولُوا الْأَلْبَـٰبِ";
const fullVerse = `${line1} ${line2} ${line3} ${line4}`;
---

<figure class="verse-panel">
  <svg
    viewBox="0 7.4 1196.7 366.6"
    role="img"
    lang="ar"
    aria-label={fullVerse}
    class="block h-auto w-full"
  >
    <defs>
      {/* panel-wide red-300 → red-500 gradient (see note 6) */}
      <linearGradient id="kufic-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="382">
        <stop offset="0" stop-color="#fca5a5" />
        <stop offset="1" stop-color="#ef4444" />
      </linearGradient>
    </defs>
    <text direction="rtl" x="1196" y="92" text-anchor="start" font-size="100" textLength="1196" lengthAdjust="spacingAndGlyphs" fill="url(#kufic-grad)">{line1}</text>
    <text direction="rtl" x="1196" y="186" text-anchor="start" font-size="100" textLength="1196" lengthAdjust="spacingAndGlyphs" fill="url(#kufic-grad)">{line2}</text>
    <text direction="rtl" x="1196" y="280" text-anchor="start" font-size="100" textLength="1196" lengthAdjust="spacingAndGlyphs" fill="url(#kufic-grad)">{line3}</text>
    <text direction="rtl" x="1196" y="374" text-anchor="start" font-size="100" textLength="1196" lengthAdjust="spacingAndGlyphs" fill="url(#kufic-grad)">{line4}</text>
  </svg>
</figure>

<style>
  /* self-hosted Square Kufic (see @file note 1) — one 21 KB woff2 */
  @font-face {
    font-family: "Square Kufic";
    src: url("/fonts/square-kufic.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .verse-panel text {
    font-family: "Square Kufic", serif;
    font-kerning: none;
  }
</style>
