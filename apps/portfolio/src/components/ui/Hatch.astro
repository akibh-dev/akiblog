---
/**
 * @file ui/Hatch.astro
 * @description Delta.dev's signature 45° diagonal hatch pattern band.
 *
 * WHY: This SVG pattern appeared 6× duplicated in the previous build.
 * As a component it's defined once and themed via the `--color-hatch`
 * token (currentColor inherits, so dark mode needs zero extra code).
 *
 * @prop height - band height (Tailwind class), default h-3
 */
interface Props {
  height?: string;
  class?: string;
  id: string; // unique pattern id — required since we render many instances
}

const { height = "h-3", class: className = "", id } = Astro.props;
---

<div aria-hidden="true" class:list={["relative overflow-hidden border-b border-line-subtle bg-canvas text-hatch", height, className]}>
  <svg class="absolute inset-0 size-full select-none">
    <defs>
      <pattern id={`hatch-${id}`} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="4" stroke="currentColor" stroke-width="1.5"></line>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#hatch-${id})`}></rect>
  </svg>
</div>
