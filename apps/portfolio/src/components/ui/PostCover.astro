---
/**
 * @file ui/PostCover.astro
 * @description Thumbnail for a blog teaser, inside delta.dev's framed
 *              "print proof" (crop lines + colour registration squares).
 *              Two modes:
 *   1. BANNER  — post.banner set (comes from blog.akibh.dev): the image,
 *                object-cover, fills the frame.
 *   2. DEFAULT — no banner: a typographic "document" thumbnail — the
 *                post rendered as a page: file path tab, a large serif
 *                drop cap of the title, and faux text lines.
 *
 * POC / WHY THIS APPROACH:
 * - Banners are authored on the blog, so the portfolio must look finished
 *   both WITH and WITHOUT one. The default isn't a grey placeholder: it
 *   reads unmistakably as "an article" and is unique per post.
 * - Faux lines are derived from a hash of the slug (deterministic) — every
 *   post gets its own paragraph rhythm, identical across builds/SSR, with
 *   no randomness that could change between renders.
 * - Same frame + same 2:1 aspect in both modes, so a row mixing bannered
 *   and banner-less posts stays aligned column to column.
 * - Banner <img> is lazy + async-decoded with explicit size (no CLS), and
 *   alt="" because the card's title already names the post (decorative).
 * - Zero JS; hover zoom is CSS on the parent .group, off under
 *   prefers-reduced-motion.
 *
 * Example: <PostCover title={post.title} slug={post.slug} banner={post.banner} />
 */
interface Props {
  title: string;
  slug: string;
  banner?: string;
}

const { title, slug, banner } = Astro.props;

/* FNV-1a → small deterministic PRNG, seeded by the slug. */
let h = 2166136261;
for (const ch of slug) h = Math.imul(h ^ ch.charCodeAt(0), 16777619) >>> 0;
const rand = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) >>> 0) % 1000) / 1000;

/* two short paragraphs of faux text; last line of each is shorter */
const paragraphs = [3, 2].map((n) =>
  Array.from({ length: n }, (_, i) => (i === n - 1 ? 35 + rand() * 30 : 82 + rand() * 18)),
);
const initial = title.trim().charAt(0).toUpperCase();
---

<div aria-hidden="true" class="relative aspect-[2/1] overflow-hidden border border-line bg-canvas">
  <div class="cover-art absolute inset-0">
    {
      banner ? (
        <img src={banner} alt="" width="960" height="480" loading="lazy" decoding="async" class="size-full object-cover" />
      ) : (
        <div class="absolute inset-3 flex flex-col px-5 py-3">
          {/* file tab */}
          <span class="truncate font-mono text-[10px] text-muted">
            ~/posts/<span class="text-subtle">{slug}</span>.md
          </span>
          {/* drop cap + faux paragraphs */}
          <div class="mt-3 flex min-h-0 flex-1 gap-4">
            <span class="font-display text-[clamp(2.75rem,5vw,4rem)] leading-[0.8] text-accent">{initial}</span>
            <div class="flex flex-1 flex-col gap-3 pt-1">
              {paragraphs.map((lines) => (
                <div class="flex flex-col gap-1.5">
                  {lines.map((w) => (
                    <span class="h-[3px] rounded-full bg-line" style={`width:${w.toFixed(1)}%`} />
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      )
    }
  </div>

  {/* proof frame — drawn OVER the art so banners get the same crop marks */}
  <span class="pointer-events-none absolute inset-x-0 inset-y-3 border-y border-line-subtle"></span>
  <span class="pointer-events-none absolute inset-y-0 inset-x-3 border-x border-line-subtle"></span>
  <span class="absolute top-2.5 left-2.5 size-1.5 bg-accent"></span>
  <span class="absolute top-2.5 right-2.5 size-1.5 bg-amber-500"></span>
  <span class="absolute bottom-2.5 left-2.5 size-1.5 bg-delta-blue"></span>
  <span class="absolute right-2.5 bottom-2.5 size-1.5 bg-accent"></span>
</div>

<style>
  .cover-art {
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(.group:hover) .cover-art {
    transform: scale(1.03);
  }
  @media (prefers-reduced-motion: reduce) {
    .cover-art { transition: none; }
    :global(.group:hover) .cover-art { transform: none; }
  }
</style>
