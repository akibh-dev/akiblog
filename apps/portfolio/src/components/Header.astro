---
/**
 * @file apps/portfolio/src/components/Header.astro
 * @description Unconventional editor-inspired top command dock, modeled after Zed.dev's interface.
 *
 * POC / Implementation Architecture:
 * - Breaks away from generic corporate navbars with a technical command-bar aesthetic.
 * - Features an active terminal status indicator (pulsing edge beacon), monospace section jump coordinates,
 *   and quick-action outbound links to the standalone blog engine and GitHub.
 * - Uses pure CSS backdrop blur and hairline border layering (`border-neutral-800/80`) for zero-layout shift.
 */

import { portfolioData } from "../data/portfolio";
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#08090d]/80 border-b border-neutral-800/70 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Left: Unconventional Terminal Identifier & Status Pill -->
    <div class="flex items-center gap-3">
      <a
        href="#about"
        class="flex items-center gap-2 text-sm font-mono text-neutral-300 hover:text-white transition-colors group"
      >
        <span class="font-semibold text-neutral-100">akib35</span>
        <span class="text-neutral-600">/</span>
        <span class="text-neutral-400 hidden sm:inline text-xs">dev</span>
      </a>
    </div>

    <!-- Center: Monospace Section Breadcrumbs -->
    <nav class="hidden md:flex items-center gap-1 font-mono text-xs">
      <a
        href="#about"
        class="px-2.5 py-1 text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800/60 rounded transition-all"
      >
        <span class="text-neutral-600 mr-1">01.</span>about
      </a>
      <a
        href="#projects"
        class="px-2.5 py-1 text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800/60 rounded transition-all"
      >
        <span class="text-neutral-600 mr-1">02.</span>projects
      </a>
      <a
        href="#writings"
        class="px-2.5 py-1 text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800/60 rounded transition-all"
      >
        <span class="text-neutral-600 mr-1">03.</span>writings
      </a>
      <a
        href="#contact"
        class="px-2.5 py-1 text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800/60 rounded transition-all"
      >
        <span class="text-neutral-600 mr-1">04.</span>contact
      </a>
    </nav>

    <!-- Right: Quick Links & Actions -->
    <div class="flex items-center gap-2 sm:gap-3 font-mono text-xs">
      <a
        href={portfolioData.meta.blogUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2.5 py-1 text-neutral-400 hover:text-white hover:bg-neutral-800/60 rounded transition-colors"
        title="Open Blog Engine"
      >
        <span>blog</span>
        <svg class="w-3 h-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          />
        </svg>
      </a>

      <a
        href={portfolioData.meta.resumeUrl}
        download
        class="inline-flex items-center gap-1.5 px-3 py-1 bg-neutral-900 hover:bg-neutral-800 text-neutral-200 hover:text-white border border-neutral-700/80 hover:border-neutral-500 rounded-md transition-all shadow-sm"
      >
        <svg class="w-3 h-3 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          />
        </svg>
        <span>cv</span>
      </a>
    </div>
  </div>
</header>
