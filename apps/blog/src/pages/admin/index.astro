---
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import StatusBadge from '../../components/admin/StatusBadge.astro';
import ServiceStatus from '../../components/admin/ServiceStatus.astro';

import { getDb } from '../../lib/db';
import { authenticateRequest } from '../../lib/auth';
import { getRuntimeEnv } from '../../lib/env';
import { runHealthChecks } from '../../lib/health';
import { getAllPostsForAdmin, getPostStats } from '../../lib/services/posts';

// Middleware already authenticated this request; re-check defensively if it did not run.
const env = getRuntimeEnv(Astro.locals);
const auth = Astro.locals.auth ?? (await authenticateRequest(Astro.request, env));
const user = auth.user;
if (!user) {
  return new Response('Unauthorized Access. Please login via Cloudflare Access.', { status: 401 });
}

// Live probes first: the status panel must render even when D1 queries below would fail.
const health = await runHealthChecks(env, auth);

let posts: Awaited<ReturnType<typeof getAllPostsForAdmin>> = [];
let stats = { totalPosts: 0, publishedCount: 0, draftCount: 0, archivedCount: 0, pendingComments: 0 };
let dataError: string | null = null;
try {
  const db = getDb(Astro.locals);
  [posts, stats] = await Promise.all([getAllPostsForAdmin(db), getPostStats(db)]);
} catch (error: any) {
  dataError = error?.message || 'Could not load posts from D1.';
}
---

<AdminLayout title="Post Management" userEmail={user.email}>
  <!-- Stats Header -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Posts</div>
      <div class="mt-2 text-3xl font-extrabold text-slate-900 dark:text-slate-100">{stats.totalPosts}</div>
    </div>
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Published</div>
      <div class="mt-2 text-3xl font-extrabold text-emerald-600 dark:text-emerald-400">{stats.publishedCount}</div>
    </div>
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-400">Drafts</div>
      <div class="mt-2 text-3xl font-extrabold text-amber-600 dark:text-amber-400">{stats.draftCount}</div>
    </div>
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">Pending Comments</div>
      <div class="mt-2 text-3xl font-extrabold text-blue-600 dark:text-blue-400">{stats.pendingComments}</div>
    </div>
  </div>

  <ServiceStatus report={health} />

  {dataError && (
    <div role="alert" class="mb-6 p-4 rounded-xl text-sm font-medium bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400">
      Posts could not be loaded: {dataError}
    </div>
  )}

  <!-- Actions Bar -->
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">Articles</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Manage all articles, drafts, and publication status.</p>
    </div>

    <a
      href="/admin/write"
      class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-colors shadow-sm"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Write New Article</span>
    </a>
  </div>

  <!-- Posts Table -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
    {posts.length === 0 ? (
      <div class="py-16 text-center text-slate-500 dark:text-slate-400">
        <p class="text-base font-semibold">No articles yet</p>
        <p class="text-sm mt-1">Get started by creating your very first post.</p>
        <div class="mt-4">
          <a
            href="/admin/write"
            class="inline-flex items-center px-4 py-2 rounded-xl bg-blue-600 text-white text-xs font-bold"
          >
            Create First Post
          </a>
        </div>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-sm">
          <thead class="bg-slate-50 dark:bg-slate-800/50">
            <tr>
              <th scope="col" class="px-6 py-4 font-bold text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400">Title</th>
              <th scope="col" class="px-6 py-4 font-bold text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400">Status</th>
              <th scope="col" class="px-6 py-4 font-bold text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400">Tags</th>
              <th scope="col" class="px-6 py-4 font-bold text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400">Date</th>
              <th scope="col" class="px-6 py-4 font-bold text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            {posts.map((post) => {
              const dateStr = post.publishedAt
                ? new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                : new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

              return (
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors" id={`post-row-${post.id}`}>
                  <td class="px-6 py-4">
                    <div class="font-bold text-slate-900 dark:text-slate-100 line-clamp-1">{post.title}</div>
                    <div class="text-xs font-mono text-slate-400 dark:text-slate-500 line-clamp-1">/{post.slug}</div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <StatusBadge status={post.status} />
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1 max-w-xs">
                      {post.tags.map((t) => (
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                          {t.name}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-xs text-slate-500 dark:text-slate-400">
                    {dateStr}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <div class="inline-flex items-center gap-2">
                      {post.status === 'published' && (
                        <a
                          href={`/posts/${post.slug}`}
                          target="_blank"
                          class="p-1.5 rounded-lg text-slate-500 hover:text-blue-600 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                          title="View live post"
                        >
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}
                      <a
                        href={`/admin/edit/${post.id}`}
                        class="p-1.5 rounded-lg text-slate-500 hover:text-blue-600 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                        title="Edit post"
                      >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                      </a>
                      <button
                        type="button"
                        class="delete-post-btn p-1.5 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors"
                        data-post-id={post.id}
                        data-post-title={post.title}
                        title="Delete post"
                      >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

<script>
  function setupDeleteButtons() {
    document.querySelectorAll('.delete-post-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const postId = btn.getAttribute('data-post-id');
        const postTitle = btn.getAttribute('data-post-title');
        if (!postId) return;

        if (confirm(`Are you sure you want to delete "${postTitle}"? This cannot be undone.`)) {
          try {
            const res = await fetch(`/api/posts/${postId}`, {
              method: 'DELETE',
              credentials: 'include',
            });
            if (res.ok) {
              const row = document.getElementById(`post-row-${postId}`);
              row?.remove();
            } else {
              const data = await res.json();
              alert(data.error || 'Failed to delete post');
            }
          } catch (e) {
            alert('Error deleting post');
          }
        }
      });
    });
  }

  setupDeleteButtons();
  document.addEventListener('astro:after-swap', setupDeleteButtons);
</script>
