---
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import { getDb } from '../../lib/db';
import { verifyAccessJWT } from '../../lib/auth';
import { getRuntimeEnv } from '../../lib/env';
import { getAllTags } from '../../lib/services/tags';

const env = getRuntimeEnv(Astro.locals);
const user = await verifyAccessJWT(Astro.request, env);
if (!user) {
  return new Response('Unauthorized Access. Please login via Cloudflare Access.', { status: 401 });
}

const db = getDb(Astro.locals);
const tags = await getAllTags(db);
---

<AdminLayout title="Tags & Categories" userEmail={user.email}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Tag Creation Form -->
    <div class="lg:col-span-5 p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-1">Create Tag</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">Add a category or topic tag to organize articles.</p>

      <form id="create-tag-form" class="space-y-4">
        <div>
          <label for="tagName" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1.5">
            Tag Name *
          </label>
          <input
            type="text"
            id="tagName"
            name="name"
            required
            placeholder="e.g. Cloudflare, Astro, TypeScript"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label for="tagSlug" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1.5">
            Slug (Optional)
          </label>
          <input
            type="text"
            id="tagSlug"
            name="slug"
            placeholder="auto-generated-if-empty"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm font-mono placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label for="tagColor" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1.5">
            Badge Accent Color
          </label>
          <div class="flex items-center gap-3">
            <input
              type="color"
              id="tagColor"
              name="color"
              value="#3B82F6"
              class="w-10 h-10 rounded-lg cursor-pointer border border-slate-200 dark:border-slate-700 bg-transparent"
            />
            <span class="text-xs text-slate-500 dark:text-slate-400">Choose a color for UI pills and accents</span>
          </div>
        </div>

        <div id="tag-form-msg" class="text-sm font-medium hidden"></div>

        <button
          type="submit"
          id="tag-submit-btn"
          class="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-colors shadow-sm disabled:opacity-50"
        >
          Add Tag
        </button>
      </form>
    </div>

    <!-- Tags List -->
    <div class="lg:col-span-7 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 dark:border-slate-800/80">
        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">All Tags ({tags.length})</h2>
      </div>

      {tags.length === 0 ? (
        <div class="py-12 text-center text-slate-500 dark:text-slate-400 text-sm">
          No tags created yet.
        </div>
      ) : (
        <div class="divide-y divide-slate-100 dark:divide-slate-800/80">
          {tags.map((tag) => (
            <div class="p-4 flex items-center justify-between hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors" id={`tag-row-${tag.id}`}>
              <div class="flex items-center gap-3">
                <span class="w-3.5 h-3.5 rounded-full shrink-0" style={`background-color: ${tag.color};`} />
                <div>
                  <div class="font-bold text-sm text-slate-900 dark:text-slate-100">{tag.name}</div>
                  <div class="text-xs font-mono text-slate-400">/tags/{tag.slug}</div>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <a
                  href={`/tags/${tag.slug}`}
                  target="_blank"
                  class="text-xs font-medium text-slate-500 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 px-2 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                >
                  View ↗
                </a>
                <button
                  type="button"
                  class="delete-tag-btn p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors"
                  data-tag-id={tag.id}
                  title="Delete tag"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</AdminLayout>

<script>
  function setupTagsManager() {
    const form = document.getElementById('create-tag-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('tag-submit-btn') as HTMLButtonElement | null;
    const msg = document.getElementById('tag-form-msg');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !msg) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Adding...';
      msg.className = 'text-sm font-medium hidden';

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        slug: formData.get('slug') || undefined,
        color: formData.get('color') || '#3B82F6',
      };

      try {
        const res = await fetch('/api/tags', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          msg.textContent = data.error || 'Failed to create tag';
          msg.className = 'text-sm font-medium text-rose-600 block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Add Tag';
        }
      } catch (e) {
        msg.textContent = 'Network error';
        msg.className = 'text-sm font-medium text-rose-600 block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Add Tag';
      }
    });

    document.querySelectorAll('.delete-tag-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-tag-id');
        if (!id) return;

        if (confirm('Are you sure you want to delete this tag?')) {
          try {
            const res = await fetch(`/api/tags/${id}`, { method: 'DELETE' });
            if (res.ok) {
              document.getElementById(`tag-row-${id}`)?.remove();
            }
          } catch (e) {
            alert('Error deleting tag');
          }
        }
      });
    });
  }

  setupTagsManager();
  document.addEventListener('astro:after-swap', setupTagsManager);
</script>
