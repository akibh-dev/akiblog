---
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import Editor from '../../components/editor/Editor';
import CoverImageField from '../../components/admin/CoverImageField.astro';

import { getDb } from '../../lib/db';
import { verifyAccessJWT } from '../../lib/auth';
import { getRuntimeEnv } from '../../lib/env';
import { getAllTags } from '../../lib/services/tags';

const env = getRuntimeEnv(Astro.locals);
const user = await verifyAccessJWT(Astro.request, env);
if (!user) {
  return new Response('Unauthorized Access. Please login via Cloudflare Access.', { status: 401 });
}

const db = getDb(Astro.locals);
const allTags = await getAllTags(db);
---

<AdminLayout title="New Article" userEmail={user.email}>
  <form id="write-post-form" class="space-y-8 max-w-4xl mx-auto">
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
      <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">Write New Article</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">Craft and publish structured content directly to the edge.</p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin"
          class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-semibold text-sm transition-colors"
        >
          Cancel
        </a>
        <button
          type="submit"
          id="save-post-btn"
          class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-colors shadow-sm disabled:opacity-50"
        >
          Save Article
        </button>
      </div>
    </div>

    <!-- Alert / Status message -->
    <div id="post-status-msg" class="hidden p-4 rounded-xl text-sm font-medium"></div>

    <!-- Post Metadata Details -->
    <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-6 shadow-sm">
      <div>
        <label for="title" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">
          Article Title *
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          placeholder="e.g. Architecting Distributed Systems with Cloudflare"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-lg font-bold placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="slug" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">
            URL Slug
          </label>
          <input
            type="text"
            id="slug"
            name="slug"
            placeholder="architecting-distributed-systems"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm font-mono placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label for="status" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">
            Publication Status
          </label>
          <select
            id="status"
            name="status"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="draft">Draft (Private)</option>
            <option value="published">Published (Public)</option>
            <option value="archived">Archived</option>
          </select>
        </div>
      </div>

      <div>
        <label for="excerpt" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">
          Excerpt / Summary
        </label>
        <textarea
          id="excerpt"
          name="excerpt"
          rows="2"
          placeholder="A brief summary for previews, SEO description, and search cards..."
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
        ></textarea>
      </div>

      <CoverImageField />

      <!-- Tag selection -->
      {allTags.length > 0 && (
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">
            Categories & Tags
          </label>
          <div class="flex flex-wrap gap-2">
            {allTags.map((tag) => (
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-xs font-medium cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <input
                  type="checkbox"
                  name="tagIds"
                  value={tag.id}
                  class="rounded text-blue-600 focus:ring-blue-500"
                />
                <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${tag.color || '#3B82F6'};`} />
                <span>{tag.name}</span>
              </label>
            ))}
          </div>
        </div>
      )}

      <!-- Comments Toggle -->
      <div class="flex items-center gap-2">
        <input
          type="checkbox"
          id="allowComments"
          name="allowComments"
          checked
          class="rounded text-blue-600 focus:ring-blue-500"
        />
        <label for="allowComments" class="text-sm font-medium text-slate-700 dark:text-slate-300 cursor-pointer">
          Allow reader comments on this article
        </label>
      </div>
    </div>

    <!-- Structured Editor.js Section -->
    <div class="space-y-2">
      <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">
        Article Content *
      </label>
      <input type="hidden" id="editor-content-input" name="contentJson" />
      <Editor
        client:only="react"
        placeholder="Start writing your article... click '+' or type '/' for blocks"
      />
    </div>
  </form>
</AdminLayout>

<script>
  function setupWriteForm() {
    const titleInput = document.getElementById('title') as HTMLInputElement | null;
    const slugInput = document.getElementById('slug') as HTMLInputElement | null;
    const form = document.getElementById('write-post-form') as HTMLFormElement | null;
    const saveBtn = document.getElementById('save-post-btn') as HTMLButtonElement | null;
    const statusMsg = document.getElementById('post-status-msg');

    if (!form) return;

    // Auto-generate slug from title if slug not manually modified
    let slugManual = false;
    slugInput?.addEventListener('input', () => {
      slugManual = Boolean(slugInput.value.trim());
    });

    titleInput?.addEventListener('input', () => {
      if (!slugManual && slugInput) {
        slugInput.value = titleInput.value
          .toLowerCase()
          .trim()
          .replace(/\s+/g, '-')
          .replace(/[^\w\-]+/g, '')
          .replace(/\-\-+/g, '-');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!saveBtn || !statusMsg) return;

      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
      statusMsg.className = 'hidden';

      const formData = new FormData(form);
      const tagIds = Array.from(formData.getAll('tagIds')) as string[];

      // Extract editor content
      let contentData: any = { blocks: [] };
      if ((window as any).editorInstance) {
        try {
          contentData = await (window as any).editorInstance.save();
        } catch (e) {
          contentData = (window as any).currentEditorContent || { blocks: [] };
        }
      } else if ((window as any).currentEditorContent) {
        contentData = (window as any).currentEditorContent;
      } else {
        const inputVal = (document.getElementById('editor-content-input') as HTMLInputElement)?.value;
        if (inputVal) {
          try { contentData = JSON.parse(inputVal); } catch {}
        }
      }

      const payload = {
        title: formData.get('title'),
        slug: formData.get('slug') || undefined,
        excerpt: formData.get('excerpt') || undefined,
        coverImage: formData.get('coverImage') || undefined,
        status: formData.get('status') || 'draft',
        allowComments: formData.get('allowComments') === 'on',
        tagIds,
        content: contentData,
      };

      try {
        const res = await fetch('/api/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload),
        });

        // Error responses may not be JSON (e.g. an edge error page); never let parsing throw.
        const data = await res.json().catch(() => ({}));
        if (res.status === 401 || res.status === 403) {
          data.error = data.message || 'Your Cloudflare Access session is no longer valid. Reload the page to sign in again; your draft stays in this tab.';
        }

        if (res.ok && data.success) {
          statusMsg.textContent = 'Post created successfully! Redirecting...';
          statusMsg.className = 'p-4 rounded-xl text-sm font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 block';
          setTimeout(() => {
            window.location.href = '/admin';
          }, 800);
        } else {
          statusMsg.textContent = data.error || 'Failed to create post';
          statusMsg.className = 'p-4 rounded-xl text-sm font-medium bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 block';
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Article';
        }
      } catch (err: any) {
        statusMsg.textContent = 'Network error saving article';
        statusMsg.className = 'p-4 rounded-xl text-sm font-medium bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 block';
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Article';
      }
    });
  }

  setupWriteForm();
  document.addEventListener('astro:after-swap', setupWriteForm);
</script>
