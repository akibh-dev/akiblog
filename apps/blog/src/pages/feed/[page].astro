---
/* For more details, see docs/blog/implementation-notes.md#src-pages-feed-page-astro-note-1. */
import PostGrid from "../../components/sections/PostGrid.astro";
import { getPosts, homeFeed, type Post } from "../../lib/posts";

export const partial = true;

export async function getStaticPaths() {
  const { later } = homeFeed(await getPosts());
  return later.map((posts, i) => ({
    params: { page: String(i + 2) },
    props: { posts, next: i + 1 < later.length ? `/feed/${i + 3}/` : undefined },
  }));
}

interface Props {
  posts: Post[];
  next?: string;
}

const { posts, next } = Astro.props;
---

<template data-feed-batch data-next={next}>
  <PostGrid posts={posts} itemsOnly />
</template>
