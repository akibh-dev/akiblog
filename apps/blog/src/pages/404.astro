---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found">
  <div class="py-24 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 font-black text-2xl mb-6">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-slate-100">
      Page Not Found
    </h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400 max-w-md mx-auto">
      The article or page you are looking for doesn't exist, was renamed, or has been removed.
    </p>
    <div class="mt-8">
      <a
        href="/"
        class="inline-flex items-center px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-colors shadow-sm"
      >
        ← Back to Homepage
      </a>
    </div>
  </div>
</Layout>
