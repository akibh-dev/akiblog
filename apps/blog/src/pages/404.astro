---
/**
 * @file pages/404.astro
 * @description Not-found page — the missing URL reported as a compiler
 *              diagnostic (rustc style), set inside the portfolio's own panel
 *              language: one bordered surface, the segmented brand rail on
 *              top, IBM Plex Serif display + Lilex mono, theme tokens only.
 *
 * WHY A COMPILER ERROR (POC / concept):
 * A developer's site should fail the way developers' tools fail. rustc's
 * diagnostics are the best-loved error format in the industry: an error
 * code, a `-->` location, the offending line with `^^^` carets under the
 * exact span, then `= help:` suggestions. Here:
 *   error[E0404]: no route matches `/the-path-you-typed`
 *    --> akibh.dev/the-path-you-typed
 *     | GET /the-path-you-typed
 *     |     ^^^^^^^^^^^^^^^^^^^ not found in this workspace
 *     = help: did you mean `/#projects`?
 * The carets are sized to the real path, and "did you mean" is a real
 * suggestion: a Levenshtein match of the path against the site's section
 * ids and files (data/sections.ts + known files), exactly like rustc's
 * "a similarly named item exists". /projcts → /#projects (edit distance),
 * /cv → the résumé (substring hit).
 * Gutter blue: brand blue tuned per theme for ≥4.5:1 on canvas — #2c5f9e
 * in light (#346dae itself is 4.45:1), #6f9fdc in
 * dark where the brand blue reads at only ~3.7:1.
 *
 * WHY STANDALONE (not Layout.astro): Layout's sidebar uses `#section`
 * anchors, which would resolve against the broken URL. This page uses
 * BaseHead (same fonts/theme/meta) and links with absolute `/#…` hrefs.
 *
 * HOW IT'S SERVED: Cloudflare Pages returns dist/404.html with HTTP 404
 * for any unknown path. Without this file Pages assumed a single-page app
 * and answered EVERY unknown URL (even /llms.txt) with the homepage and
 * 200 — a soft-404 that search engines penalise.
 *
 * SEO: noindex (BaseHead) and excluded from the sitemap (astro.config).
 * CSP: the script is a normal bundled module (hashed by Astro's CSP);
 * data comes from data-routes, never define:vars (see the script).
 * NO JS REQUIRED: the static HTML shows a generic path; the tiny script
 * only personalises it (path, carets, suggestion).
 *
 * Copied from apps/portfolio/src/pages/404.astro @ 091c7cf. Keep the
 * markup/script in sync. BLOG ADAPTATION (data only, plan20 §4):
 * - routes = blog stations + every post slug + every tag, so a typo in a
 *   post URL (/playwrite-setup) suggests the real post. The matcher
 *   compares the LAST path segment with each key — the slug for posts.
 * - "Available routes" lists the site sections (stations) only; listing
 *   every post would turn the diagnostic into an archive page.
 * - Buttons: Home + Portfolio ↗ (the portfolio's 404 points at the blog).
 */
import "../styles/global.css";
import BaseHead from "../layouts/BaseHead.astro";
import { site, stations, stationHref } from "../data/site";
import { getPosts, postUrl, tagIndex } from "../lib/posts";

const posts = await getPosts();
const host = new URL(site.url).host;
const sections = stations.filter((s) => !s.external);

/* suggestion targets: every station + every post + every tag + feeds */
const routes = [
  ...sections.map((s) => ({ key: s.id, href: stationHref(s, false), label: s.label })),
  ...posts.map((p) => ({ key: p.id, href: postUrl(p), label: p.data.title })),
  ...tagIndex(posts).map(({ tag }) => ({ key: tag, href: `/tags/${tag}/`, label: `#${tag}` })),
  { key: "rss", href: "/rss.xml", label: "RSS feed" },
  { key: "feed", href: "/rss.xml", label: "RSS feed" },
  { key: "portfolio", href: site.portfolioUrl, label: "Portfolio" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="404 — not found" description="This page doesn't exist." noindex />
  </head>

  <body class="flex min-h-dvh items-center justify-center bg-frame-background p-4 text-default antialiased">
    <main class="w-full max-w-3xl" data-routes={JSON.stringify(routes)}>
      {/* segmented rail — the same [3 brand | 2 gray | 3 blue] bar that sits atop the site */}
      <div aria-hidden="true" class="grid h-1.5 grid-cols-8">
        <span class="col-span-3 bg-accent"></span>
        <span class="col-span-2 bg-line"></span>
        <span class="col-span-3 bg-delta-blue"></span>
      </div>

      <div class="border border-t-0 border-line bg-surface">
        {/* heading */}
        <div class="border-b border-line px-5 py-8 md:px-10 md:py-10">
          <p class="font-mono text-2xs uppercase tracking-widest text-muted">exit status 404</p>
          <h1 class="mt-3 font-display text-[clamp(2.25rem,4vw+1rem,3.75rem)] leading-[1.05] tracking-tight">
            Page not found<span class="text-accent">.</span>
          </h1>
          <p class="mt-3 max-w-lg font-mono text-xs leading-relaxed text-subtle">
            The build passed, the route didn't. Here's the diagnostic:
          </p>
        </div>

        {/* the diagnostic */}
        <pre
          class="overflow-x-auto bg-canvas px-5 py-6 font-mono text-xs leading-relaxed text-subtle md:px-10"
          aria-label="Error details"
        ><code><span class="font-semibold text-accent">error[E0404]</span><span class="font-semibold text-default">: no route matches `<span data-path>/this-page</span>`</span>
<span class="text-[#2c5f9e] dark:text-[#6f9fdc]"> --&gt;</span> {host}<span data-path>/this-page</span>
<span class="text-[#2c5f9e] dark:text-[#6f9fdc]">  |</span>
<span class="text-[#2c5f9e] dark:text-[#6f9fdc]">1 |</span> GET <span data-path>/this-page</span>
<span class="text-[#2c5f9e] dark:text-[#6f9fdc]">  |</span>     <span class="text-accent" data-carets>^^^^^^^^^^</span> <span class="text-accent">not found in this workspace</span>
<span class="text-[#2c5f9e] dark:text-[#6f9fdc]">  |</span>
<span class="text-[#2c5f9e] dark:text-[#6f9fdc]">  =</span> <span class="font-semibold text-default">help</span>: <span data-suggest>the page may have moved, or the link has a typo</span>
<span class="text-[#2c5f9e] dark:text-[#6f9fdc]">  =</span> <span class="font-semibold text-default">note</span>: available routes are listed below</code></pre>

        {/* routes — the "candidates" list, as real links */}
        <nav aria-label="Site sections" class="border-t border-line px-5 py-6 md:px-10">
          <p class="mb-3 font-mono text-2xs uppercase tracking-widest text-muted">Available routes</p>
          <ul class="grid grid-cols-2 gap-x-6 gap-y-1 sm:grid-cols-3">
            {
              sections.map((s) => (
                <li>
                  <a
                    href={stationHref(s, false)}
                    class="flex min-h-8 items-center font-mono text-xs text-subtle transition-colors hover:text-accent"
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        {/* actions */}
        <div class="flex flex-wrap items-center gap-3 border-t border-line px-5 py-6 md:px-10">
          <a href="/" class="btn-primary inline-flex items-center gap-2 rounded-sm px-5 py-2.5 font-mono text-2xs uppercase tracking-wider">
            cd ~ <span aria-hidden="true">→</span> Home
          </a>
          <a href={site.portfolioUrl} class="btn inline-flex items-center gap-1.5 rounded-sm px-5 py-2.5 font-mono text-2xs uppercase tracking-wider">
            Portfolio <span aria-hidden="true">↗</span>
          </a>
          <a href={`mailto:${site.author.email}?subject=Broken%20link%20on%20${host}`} data-report class="ml-auto font-mono text-2xs text-muted underline-offset-4 transition-colors hover:text-accent hover:underline">
            Report a broken link
          </a>
        </div>
      </div>
    </main>

    <script>
      // Personalise the diagnostic: real path, caret span, nearest route.
      // Routes arrive as JSON in data-routes (not define:vars): define:vars
      // emits an inline script whose body changes per build, which Astro's
      // CSP can't hash, so the browser would refuse to run it.
      type Route = { key: string; href: string; label: string };
      const routes: Route[] = JSON.parse(document.querySelector("main")?.dataset.routes ?? "[]");
      const path = decodeURIComponent(location.pathname) || "/";
      document.querySelectorAll("[data-path]").forEach((el) => (el.textContent = path));
      const carets = document.querySelector("[data-carets]");
      if (carets) carets.textContent = "^".repeat(Math.min(path.length, 48));

      // Levenshtein distance between two short strings
      const dist = (a: string, b: string) => {
        const row = Array.from({ length: b.length + 1 }, (_, i) => i);
        for (let i = 1; i <= a.length; i++) {
          let prev = row[0]++;
          for (let j = 1; j <= b.length; j++) {
            const cur = row[j];
            row[j] = Math.min(row[j] + 1, row[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
            prev = cur;
          }
        }
        return row[b.length];
      };

      // compare the last meaningful path segment with every route key
      const seg = path.toLowerCase().split("/").filter(Boolean).pop()?.replace(/\.[a-z0-9]+$/, "") ?? "";
      let best: (Route & { d: number }) | null = null;
      for (const r of routes) {
        // a key contained in the segment (or vice versa) is a direct hit:
        // /cv → cv, /project → projects
        const d = seg.length >= 2 && (seg.includes(r.key) || r.key.includes(seg)) ? 0 : dist(seg, r.key);
        if (!best || d < best.d) best = { ...r, d };
      }
      const suggest = document.querySelector("[data-suggest]");
      if (suggest && best && seg && best.d <= Math.max(2, Math.floor(best.key.length / 3))) {
        suggest.textContent = "did you mean ";
        const a = document.createElement("a");
        a.href = best.href;
        a.textContent = `\`${best.href}\``;
        a.className = "text-accent underline underline-offset-4";
        suggest.append(a, `? (${best.label})`);
      }

      const report = document.querySelector<HTMLAnchorElement>("[data-report]");
      if (report) report.href += `&body=${encodeURIComponent(`Missing page: ${location.href}\nReferrer: ${document.referrer || "(direct)"}`)}`;
    </script>
  </body>
</html>
