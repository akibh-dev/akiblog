---
// CodeBlock.astro
interface Props {
  code: string;
  language?: string;
}

const { code, language = 'text' } = Astro.props;
---

<div class="relative my-6 rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-900 text-slate-100 shadow-md">
  <div class="flex items-center justify-between px-4 py-2.5 bg-slate-800/80 border-b border-slate-700/60 text-xs font-mono text-slate-400">
    <span class="uppercase tracking-wider">{language}</span>
    <button
      type="button"
      class="copy-code-btn px-2.5 py-1 rounded bg-slate-700/80 hover:bg-slate-600 text-slate-200 transition-colors text-xs font-sans"
      data-code={code}
    >
      Copy
    </button>
  </div>
  <pre class="p-4 sm:p-5 overflow-x-auto text-sm sm:text-base font-mono leading-relaxed"><code class={`language-${language}`}>{code}</code></pre>
</div>

<script>
  function setupCopyButtons() {
    document.querySelectorAll('.copy-code-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (code) {
          await navigator.clipboard.writeText(code);
          const origText = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = origText;
          }, 2000);
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:after-swap', setupCopyButtons);
</script>
