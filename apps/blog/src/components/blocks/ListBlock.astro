---
// ListBlock.astro
interface Props {
  items: (string | { content?: string })[];
  style?: 'ordered' | 'unordered';
}

const { items, style = 'unordered' } = Astro.props;

const Tag = style === 'ordered' ? 'ol' : 'ul';
const listClasses =
  style === 'ordered'
    ? 'list-decimal list-outside pl-6 space-y-2.5 my-4 text-slate-700 dark:text-slate-300 text-lg leading-relaxed'
    : 'list-disc list-outside pl-6 space-y-2.5 my-4 text-slate-700 dark:text-slate-300 text-lg leading-relaxed';
---

<Tag class={listClasses}>
  {items.map((item) => {
    const content = typeof item === 'string' ? item : item?.content || '';
    return <li set:html={content} />;
  })}
</Tag>
