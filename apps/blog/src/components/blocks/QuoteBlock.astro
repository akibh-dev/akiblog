---
// QuoteBlock.astro
interface Props {
  text: string;
  caption?: string;
  alignment?: 'left' | 'center';
}

const { text, caption, alignment = 'left' } = Astro.props;
---

<figure class={`my-8 p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border-l-4 border-blue-500 text-${alignment}`}>
  <blockquote class="text-xl italic font-serif text-slate-800 dark:text-slate-200 leading-relaxed">
    <p set:html={text} />
  </blockquote>
  {caption && (
    <figcaption class="mt-3 text-sm font-medium text-slate-500 dark:text-slate-400 not-italic">
      — {caption}
    </figcaption>
  )}
</figure>
