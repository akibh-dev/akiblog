---
/* For more details, see docs/blog/implementation-notes.md#src-components-sections-postgrid-astro-note-1. */
import PostCard from "../ui/PostCard.astro";
import type { Post } from "../../lib/posts";

interface Props {
  posts: Post[];
  headingLevel?: "h2" | "h3";
  id?: string;
  itemsOnly?: boolean;
}

const { posts, headingLevel, id, itemsOnly = false } = Astro.props;
---

{
  itemsOnly ? (
    posts.map((post) => (
      <li class="flex border-b border-line">
        <PostCard post={post} headingLevel={headingLevel} />
      </li>
    ))
  ) : (
    <ul id={id} class="post-grid grid border-t border-line md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <li class="flex border-b border-line">
          <PostCard post={post} headingLevel={headingLevel} />
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .post-grid > li:nth-child(2n) {
      border-left: 1px solid var(--ui-border);
    }
    .post-grid > li:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
  }
  @media (min-width: 64rem) {
    .post-grid > li:not(:nth-child(3n + 1)) {
      border-left: 1px solid var(--ui-border);
    }
    .post-grid > li:nth-last-child(-n + 3):nth-child(3n + 1),
    .post-grid > li:nth-last-child(-n + 3):nth-child(3n + 1) ~ li {
      border-bottom: 0;
    }
  }
  .post-grid > li:last-child {
    border-bottom: 0;
  }
</style>
