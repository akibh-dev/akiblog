---
// AdminNav.astro - Navigation for Admin Dashboard
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  userEmail?: string;
}

const { userEmail = 'admin@akib35.me' } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Posts', exact: true },
  { href: '/admin/write', label: 'New Post', exact: false },
  { href: '/admin/comments', label: 'Comments', exact: false },
  { href: '/admin/tags', label: 'Tags', exact: false },
];
---

<header class="sticky top-0 z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href="/admin" class="flex items-center gap-2 font-black text-lg tracking-tight text-slate-900 dark:text-slate-100">
        <span class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-sm">
          A
        </span>
        <span>Studio</span>
      </a>

      <nav class="hidden sm:flex items-center gap-1">
        {navItems.map((item) => {
          const isActive = item.exact
            ? currentPath === item.href
            : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
                isActive
                  ? 'bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 font-semibold'
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex items-center gap-4">
      <div class="hidden md:flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-800 rounded-full px-3 py-1 bg-slate-50 dark:bg-slate-800/50">
        <span class="w-2 h-2 rounded-full bg-emerald-500" />
        <span class="font-mono">{userEmail}</span>
      </div>

      <a
        href="/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        View Blog ↗
      </a>

      <ThemeToggle />
    </div>
  </div>

  <!-- Mobile nav row -->
  <div class="sm:hidden flex items-center justify-around border-t border-slate-100 dark:border-slate-800/80 px-2 py-1.5 overflow-x-auto">
    {navItems.map((item) => {
      const isActive = item.exact
        ? currentPath === item.href
        : currentPath.startsWith(item.href);
      return (
        <a
          href={item.href}
          class={`px-3 py-1 rounded-md text-xs font-medium ${
            isActive
              ? 'bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-slate-600 dark:text-slate-400'
          }`}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>
