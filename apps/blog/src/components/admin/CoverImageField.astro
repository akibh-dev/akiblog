---
/**
 * @file CoverImageField.astro
 * @description Cover image input for the write/edit forms: paste a URL or upload to R2.
 *
 * - Keeps the original `name="coverImage"` / `id="coverImage"` contract, so the existing form
 *   submit code (FormData -> POST/PUT /api/posts) is unchanged.
 * - Upload posts to /api/upload (same endpoint and response shape as the Editor.js image tool)
 *   and writes the returned `/api/media/uploads/...` URL into the field, then previews it.
 * - Client-side type/size pre-check mirrors the server rules (src/lib/storage.ts) for instant
 *   feedback; the server remains the authority.
 */
interface Props {
  value?: string | null;
}

const { value = '' } = Astro.props;
---

<div data-cover-field>
  <label for="coverImage" class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">
    Cover Image
  </label>
  <div class="flex flex-col sm:flex-row gap-2">
    <input
      type="text"
      inputmode="url"
      id="coverImage"
      name="coverImage"
      value={value || ''}
      placeholder="Paste an image URL or upload a file"
      class="flex-1 min-w-0 px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
    <input type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" class="sr-only" data-cover-file tabindex="-1" aria-hidden="true" />
    <button
      type="button"
      data-cover-upload
      class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 disabled:opacity-60 disabled:cursor-wait"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 16V4" /><path d="m6 10 6-6 6 6" /><path d="M4 20h16" />
      </svg>
      <span data-cover-label>Upload to R2</span>
    </button>
  </div>
  <p data-cover-msg role="status" aria-live="polite" class="hidden mt-2 text-xs font-medium"></p>
  <img
    data-cover-preview
    src={value || undefined}
    alt="Cover image preview"
    class={`mt-3 max-h-48 rounded-xl border border-slate-200 dark:border-slate-800 object-cover ${value ? '' : 'hidden'}`}
  />
</div>

<script>
  const ALLOWED = ['image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/avif'];
  const MAX_BYTES = 10 * 1024 * 1024;

  function setupCoverFields() {
    document.querySelectorAll<HTMLElement>('[data-cover-field]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = 'true';

      const input = root.querySelector<HTMLInputElement>('#coverImage');
      const fileInput = root.querySelector<HTMLInputElement>('[data-cover-file]');
      const button = root.querySelector<HTMLButtonElement>('[data-cover-upload]');
      const label = root.querySelector('[data-cover-label]');
      const msg = root.querySelector<HTMLElement>('[data-cover-msg]');
      const preview = root.querySelector<HTMLImageElement>('[data-cover-preview]');
      if (!input || !fileInput || !button || !msg || !preview) return;

      const say = (text: string, tone: 'ok' | 'error') => {
        msg.textContent = text;
        msg.className = `mt-2 text-xs font-medium ${tone === 'ok' ? 'text-emerald-700 dark:text-emerald-400' : 'text-rose-700 dark:text-rose-400'}`;
      };
      const showPreview = (url: string) => {
        preview.classList.toggle('hidden', !url);
        if (url) preview.src = url;
      };

      input.addEventListener('change', () => showPreview(input.value.trim()));
      preview.addEventListener('error', () => preview.classList.add('hidden'));
      button.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        fileInput.value = '';
        if (!file) return;
        if (!ALLOWED.includes(file.type)) return say('Use a PNG, JPEG, WebP, GIF or AVIF image.', 'error');
        if (file.size > MAX_BYTES) return say('That image is larger than 10 MB.', 'error');

        button.disabled = true;
        if (label) label.textContent = 'Uploading…';
        msg.classList.add('hidden');

        try {
          const body = new FormData();
          body.append('image', file);
          const res = await fetch('/api/upload', { method: 'POST', body, credentials: 'include' });
          const data = await res.json().catch(() => null);
          if (!res.ok || !data?.success) {
            throw new Error(res.status === 401 ? 'Session expired. Reload the page to sign in again.' : data?.error || `Upload failed (HTTP ${res.status})`);
          }
          input.value = data.file.url;
          showPreview(data.file.url);
          say('Uploaded to R2.', 'ok');
        } catch (err: any) {
          say(err?.message || 'Upload failed.', 'error');
        } finally {
          button.disabled = false;
          if (label) label.textContent = 'Upload to R2';
        }
      });
    });
  }

  setupCoverFields();
  document.addEventListener('astro:after-swap', setupCoverFields);
</script>
