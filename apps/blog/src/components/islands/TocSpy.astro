---
/* For more details, see docs/blog/implementation-notes.md#src-components-islands-tocspy-astro-note-1. */
---

<toc-spy class="contents"><slot /></toc-spy>

<script>
  const SETTLE_MS = 750; // ≥ smooth-scroll duration of a long jump

  class TocSpy extends HTMLElement {
    private links: HTMLAnchorElement[] = [];
    private headings: HTMLElement[] = [];
    private current: HTMLAnchorElement | null = null;
    private frame?: number;
    private settle?: ReturnType<typeof setTimeout>;
    private suppress = false;

    connectedCallback() {
      const pairs = [...this.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]")]
        .map((a) => ({ a, h: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
        .filter((p): p is { a: HTMLAnchorElement; h: HTMLElement } => p.h !== null);
      this.links = pairs.map((p) => p.a);
      this.headings = pairs.map((p) => p.h);
      if (this.headings.length === 0) return;

      this.addEventListener("click", this.onClick);
      addEventListener("scroll", this.schedule, { passive: true });
      addEventListener("resize", this.schedule, { passive: true });

      // the hash itself is stripped by Layout's clean-URL script; it records it first
      const arrived = document.documentElement.dataset.arrivedHash ?? decodeURIComponent(location.hash.slice(1));
      const fromHash = this.headings.findIndex((h) => h.id === arrived);
      if (fromHash >= 0) this.set(this.links[fromHash]);
      else this.update();
    }

    disconnectedCallback() {
      this.removeEventListener("click", this.onClick);
      removeEventListener("scroll", this.schedule);
      removeEventListener("resize", this.schedule);
      if (this.frame) cancelAnimationFrame(this.frame);
      clearTimeout(this.settle);
    }

    private schedule = () => {
      if (this.suppress || this.frame !== undefined) return;
      this.frame = requestAnimationFrame(() => {
        this.frame = undefined;
        this.update();
      });
    };

    private update() {
      const y = scrollY;
      if (y + innerHeight >= document.documentElement.scrollHeight - 4) return this.set(this.links.at(-1)!);
      const margin = parseFloat(getComputedStyle(this.headings[0]).scrollMarginTop) || 0;
      let active = 0;
      for (let i = 0; i < this.headings.length; i++) {
        if (y >= this.headings[i].getBoundingClientRect().top + y - margin - 2) active = i;
        else break;
      }
      this.set(this.links[active]);
    }

    private set(link: HTMLAnchorElement) {
      if (link === this.current) return;
      this.current?.removeAttribute("aria-current");
      link.setAttribute("aria-current", "location");
      this.current = link;
      this.markTrail(link);
      this.reveal(link);
    }

    /** ancestors of the active row: walk up, keeping each shallower lane once */
    private markTrail(link: HTMLAnchorElement) {
      this.links.forEach((l) => l.removeAttribute("data-trail"));
      let lane = Number(link.dataset.lane ?? 0);
      for (let i = this.links.indexOf(link) - 1; i >= 0 && lane > 0; i--) {
        const l = Number(this.links[i].dataset.lane ?? 0);
        if (l < lane) {
          this.links[i].setAttribute("data-trail", "");
          lane = l;
        }
      }
    }

    /** keep the active link inside its nearest scrolling ancestor (not the window) */
    private reveal(link: HTMLAnchorElement) {
      const box = link.closest<HTMLElement>("[data-toc-scroll]");
      if (!box) return;
      const b = box.getBoundingClientRect();
      const r = link.getBoundingClientRect();
      const pad = 48;
      if (r.top < b.top + pad) box.scrollTop -= b.top + pad - r.top;
      else if (r.bottom > b.bottom - pad) box.scrollTop += r.bottom - (b.bottom - pad);
    }

    private onClick = (e: Event) => {
      const link = (e.target as Element).closest<HTMLAnchorElement>("a[data-toc-link]");
      if (!link) return;
      this.set(link);
      this.suppress = true;
      clearTimeout(this.settle);
      this.settle = setTimeout(() => (this.suppress = false), SETTLE_MS);
    };
  }

  if (!customElements.get("toc-spy")) customElements.define("toc-spy", TocSpy);
</script>
