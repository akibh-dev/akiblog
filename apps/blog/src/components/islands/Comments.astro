---
/**
 * @file islands/Comments.astro
 * @description giscus comments panel (GitHub Discussions on
 *              akibh-dev/notes). Renders NOTHING until src/config/giscus.ts
 *              is filled in (plan21 §3), so posts ship without a dead slot.
 *
 * WHY A CUSTOM LOADER (not giscus's copy-paste <script data-*>):
 * - CSP: that snippet is a third-party <script> whose attributes we'd
 *   have to inline; here a bundled module (hashed by Astro) injects it.
 * - Lazy: client.js + the iframe load only when the panel is within
 *   ~600px of the viewport (IntersectionObserver), so readers who never
 *   reach the end download nothing.
 * - Theme: the blog's OWN giscus themes, public/giscus/light.css and
 *   dark.css (giscus base theme + the blog's tokens resolved to rgb + the
 *   blog fonts), picked from <html class="dark"> at load. A
 *   MutationObserver re-sends `setConfig({ theme })` to the iframe
 *   whenever the site's toggle flips — comments never stay in the wrong
 *   theme. On localhost the stock giscus light/dark themes are used
 *   (a public iframe can't load localhost resources — Chrome Private
 *   Network Access); previews and production use the blog's files.
 * Config rides in data-* attributes (no define:vars → CSP-safe).
 *
 * Example: <Comments term={post.id} />
 */
import { giscus } from "../../config/giscus";

interface Props {
  /** used only with mapping "specific" */
  term: string;
}

const { term } = Astro.props;
const cfg = giscus;
---

{
  cfg && (
    <giscus-comments
      class="block min-h-40"
      data-repo={cfg.repo}
      data-repo-id={cfg.repoId}
      data-category={cfg.category}
      data-category-id={cfg.categoryId}
      data-mapping={cfg.mapping}
      data-term={cfg.term ?? term}
      data-reactions-enabled={cfg.reactionsEnabled === false ? "0" : "1"}
      data-input-position={cfg.inputPosition ?? "top"}
      data-lang={cfg.lang ?? "en"}
    >
      <p class="font-mono text-2xs uppercase tracking-wider text-muted">Loading comments…</p>
    </giscus-comments>
  )
}

<script>
  // the blog's own themes (public/giscus/{light,dark}.css), as ABSOLUTE
  // urls — giscus loads them inside its iframe on giscus.app.
  // On localhost the stock giscus themes are used instead: Chrome's Private
  // Network Access rule stops a public page (giscus.app) from loading
  // anything from localhost, so a custom theme can't work in `astro dev`.
  const local = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
  const theme = () => {
    const mode = document.documentElement.classList.contains("dark") ? "dark" : "light";
    return local ? mode : new URL(`/giscus/${mode}.css`, location.origin).href;
  };

  class GiscusComments extends HTMLElement {
    connectedCallback() {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          this.mount();
        },
        { rootMargin: "600px 0px" },
      );
      io.observe(this);
    }

    private mount() {
      const d = this.dataset;
      const s = document.createElement("script");
      s.src = "https://giscus.app/client.js";
      s.async = true;
      s.crossOrigin = "anonymous";
      const attrs: Record<string, string | undefined> = {
        "data-repo": d.repo,
        "data-repo-id": d.repoId,
        "data-category": d.category,
        "data-category-id": d.categoryId,
        "data-mapping": d.mapping,
        "data-term": d.term,
        "data-strict": "1",
        "data-reactions-enabled": d.reactionsEnabled,
        "data-emit-metadata": "0",
        "data-input-position": d.inputPosition,
        "data-theme": theme(),
        "data-lang": d.lang,
        "data-loading": "lazy",
      };
      for (const [k, v] of Object.entries(attrs)) if (v) s.setAttribute(k, v);
      this.replaceChildren(s);

      // follow the site theme toggle
      new MutationObserver(() => {
        const frame = this.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
        frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, "https://giscus.app");
      }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
    }
  }

  if (!customElements.get("giscus-comments")) customElements.define("giscus-comments", GiscusComments);
</script>
