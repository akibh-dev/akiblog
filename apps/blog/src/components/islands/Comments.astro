---
/* For more details, see docs/blog/implementation-notes.md#src-components-islands-comments-astro-note-1. */
import { giscus } from "../../config/giscus";

interface Props {
  /** used only with mapping "specific" */
  term: string;
}

const { term } = Astro.props;
const cfg = giscus;
---

{
  cfg && (
    <giscus-comments
      class="block min-h-40"
      data-repo={cfg.repo}
      data-repo-id={cfg.repoId}
      data-category={cfg.category}
      data-category-id={cfg.categoryId}
      data-mapping={cfg.mapping}
      data-term={cfg.term ?? term}
      data-reactions-enabled={cfg.reactionsEnabled === false ? "0" : "1"}
      data-input-position={cfg.inputPosition ?? "top"}
      data-lang={cfg.lang ?? "en"}
    >
      <p data-giscus-status class="font-mono text-2xs uppercase tracking-wider text-muted">Loading comments…</p>
    </giscus-comments>
  )
}

<script>
  // For more details, see docs/blog/implementation-notes.md#src-components-islands-comments-astro-note-2.
  const local = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
  const theme = () => {
    const mode = document.documentElement.classList.contains("dark") ? "dark" : "light";
    return local ? mode : new URL(`/giscus/${mode}.css`, location.origin).href;
  };

  const GISCUS_ORIGIN = "https://giscus.app";
  // client.js + iframe normally render in 1–3s; 15s leaves room for slow
  // mobile links before calling it an outage
  const LOAD_TIMEOUT = 15_000;

  class GiscusComments extends HTMLElement {
    connectedCallback() {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          this.mount();
        },
        { rootMargin: "600px 0px" },
      );
      io.observe(this);
    }

    private mount() {
      const d = this.dataset;
      const s = document.createElement("script");
      s.src = "https://giscus.app/client.js";
      s.async = true;
      s.crossOrigin = "anonymous";
      const attrs: Record<string, string | undefined> = {
        "data-repo": d.repo,
        "data-repo-id": d.repoId,
        "data-category": d.category,
        "data-category-id": d.categoryId,
        "data-mapping": d.mapping,
        "data-term": d.term,
        "data-strict": "1",
        "data-reactions-enabled": d.reactionsEnabled,
        "data-emit-metadata": "0",
        "data-input-position": d.inputPosition,
        "data-theme": theme(),
        "data-lang": d.lang,
        "data-loading": "lazy",
      };
      for (const [k, v] of Object.entries(attrs)) if (v) s.setAttribute(k, v);
      // keep the status line beside the script: client.js inserts the
      // iframe next to its own <script>, so the line can sit above it
      const status = this.querySelector<HTMLElement>("[data-giscus-status]");
      this.append(s);

      const fail = () => {
        if (!status?.isConnected) return;
        const link = document.createElement("a");
        link.href = `https://github.com/${d.repo}/discussions`;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "text-accent underline-offset-2 hover:underline";
        link.textContent = "GitHub Discussions ↗";
        status.className = "font-mono text-2xs text-muted"; // sentence case, not the loading label's caps
        status.replaceChildren("Comments couldn't load — giscus may be down. Try later or join on ", link);
      };
      const timer = setTimeout(fail, LOAD_TIMEOUT);
      s.addEventListener("error", () => {
        clearTimeout(timer);
        fail();
      });
      // first message from the iframe = it rendered → drop the status line
      const alive = (e: MessageEvent) => {
        if (e.origin !== GISCUS_ORIGIN) return;
        clearTimeout(timer);
        status?.remove();
        window.removeEventListener("message", alive);
      };
      window.addEventListener("message", alive);

      // follow the site theme toggle
      new MutationObserver(() => {
        const frame = this.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
        frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, "https://giscus.app");
      }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
    }
  }

  if (!customElements.get("giscus-comments")) customElements.define("giscus-comments", GiscusComments);
</script>
