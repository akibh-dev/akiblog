---
/* For more details, see docs/blog/implementation-notes.md#src-components-islands-searchshortcut-astro-note-1. */
---

<script>
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
    const slash = e.key === "/" && !e.ctrlKey && !e.metaKey && !e.altKey;
    const k = e.key.toLowerCase() === "k" && (e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey;
    if (!slash && !k) return;
    e.preventDefault();
    const box = document.querySelector<HTMLInputElement>("blog-search input");
    if (!box) return location.assign("/#search");
    document.getElementById("search")?.scrollIntoView({ block: "start" });
    box.focus({ preventScroll: true });
  });
</script>
