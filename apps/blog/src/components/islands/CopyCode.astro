---
/* For more details, see docs/blog/implementation-notes.md#src-components-islands-copycode-astro-note-1. */
---

<script>
  const timers = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();

  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLButtonElement>("button[data-copy]");
    const code = btn?.closest("figure.code-block")?.querySelector("pre code");
    if (!btn || !code) return;

    let ok = false;
    try {
      await navigator.clipboard.writeText((code.textContent ?? "").replace(/\n$/, ""));
      ok = true;
    } catch {
      /* clipboard blocked (permissions / insecure context) */
    }
    btn.textContent = ok ? "Copied!" : "Failed";
    btn.dataset.ok = String(ok);
    clearTimeout(timers.get(btn));
    timers.set(
      btn,
      setTimeout(() => {
        btn.textContent = "Copy";
        btn.dataset.ok = "false";
      }, 2000),
    );
  });
</script>
