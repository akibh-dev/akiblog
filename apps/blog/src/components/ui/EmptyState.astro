---
// EmptyState.astro - Separated Empty State Component
interface Props {
  title?: string;
  description?: string;
  actionHref?: string;
  actionText?: string;
}

const {
  title = 'No articles found',
  description = 'Try searching with different keywords or selecting another tag.',
  actionHref,
  actionText,
} = Astro.props;
---

<div class="py-16 text-center border border-dashed border-slate-300 dark:border-slate-800 rounded-3xl p-8">
  <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 mx-auto flex items-center justify-center mb-4">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
    </svg>
  </div>
  <h3 class="text-lg font-bold text-slate-800 dark:text-slate-200">{title}</h3>
  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto">{description}</p>
  {actionHref && actionText && (
    <div class="mt-6">
      <a
        href={actionHref}
        class="inline-flex items-center px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition-colors shadow-sm"
      >
        {actionText}
      </a>
    </div>
  )}
</div>
