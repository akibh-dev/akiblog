---
// TagBadge.astro - Separated Tag Component
import type { Tag } from '@repo/db';

interface Props {
  tag: Tag | { name: string; slug: string; color?: string };
  size?: 'sm' | 'md';
  clickable?: boolean;
}

const { tag, size = 'sm', clickable = true } = Astro.props;

const sizeClasses = size === 'sm' ? 'text-xs px-2.5 py-1' : 'text-sm px-3.5 py-1.5';
const color = tag.color || '#3B82F6';
---

{clickable ? (
  <a
    href={`/tags/${tag.slug}`}
    class={`inline-flex items-center gap-1.5 font-medium rounded-full transition-colors border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-700 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 hover:text-blue-600 dark:hover:text-blue-400 ${sizeClasses}`}
  >
    <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${color};`} />
    <span>{tag.name}</span>
  </a>
) : (
  <span
    class={`inline-flex items-center gap-1.5 font-medium rounded-full border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-700 dark:text-slate-300 ${sizeClasses}`}
  >
    <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${color};`} />
    <span>{tag.name}</span>
  </span>
)}
