---
/**
 * @file ui/ScrollRow.astro
 * @description Horizontal snap-scroller for card rows (metrics, posts, skills).
 *
 * WHY: CSS scroll-snap gives native-feeling horizontal scrolling with zero
 * JavaScript. Edge fade masks signal overflow. Cards size fluidly with
 * min() so they never overflow small viewports (the responsiveness bug in
 * the previous build used fixed 320px cards).
 */
interface Props {
  class?: string;
  label?: string; // aria-label for the scroll region
}

const { class: className = "", label = "Scrollable content" } = Astro.props;
---

<div class="group/row relative -mx-5 md:-mx-8">
  <div
    role="region"
    aria-label={label}
    tabindex="0"
    class:list={[
      "no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-5 px-5 pb-2",
      "md:scroll-px-8 md:px-8",
      className,
    ]}
  >
    <slot />
  </div>
  <!-- edge fade hint -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-canvas to-transparent"></div>
</div>
