---
// Header.astro - Separated Navigation & Site Header Component
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteTitle?: string;
}

const { siteTitle = 'akib.log' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/80 dark:bg-slate-900/80 border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo / Title -->
    <a href="/" class="flex items-center gap-2.5 font-black text-xl tracking-tight text-slate-900 dark:text-slate-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
      <span class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-base shadow-sm">
        A
      </span>
      <span>{siteTitle}</span>
    </a>

    <!-- Nav Links & Theme Toggle -->
    <div class="flex items-center gap-3 sm:gap-6">
      <nav class="flex items-center gap-1 sm:gap-2">
        <a
          href="/"
          class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
            currentPath === '/'
              ? 'bg-slate-100 dark:bg-slate-800 text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100'
          }`}
        >
          Articles
        </a>
        <a
          href="/admin"
          class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
            currentPath.startsWith('/admin')
              ? 'bg-slate-100 dark:bg-slate-800 text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100'
          }`}
        >
          Admin
        </a>
      </nav>

      <div class="h-4 w-px bg-slate-200 dark:bg-slate-800" />

      <ThemeToggle />
    </div>
  </div>
</header>
