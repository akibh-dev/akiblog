---
// TableOfContents.astro - Separated Table of Contents Component
interface Props {
  contentJson: string;
}

const { contentJson } = Astro.props;

interface TocItem {
  id: string;
  text: string;
  level: number;
}

const items: TocItem[] = [];

try {
  if (contentJson && contentJson.trim().startsWith('{')) {
    const parsed = JSON.parse(contentJson);
    if (Array.isArray(parsed.blocks)) {
      for (const block of parsed.blocks) {
        if (block.type === 'header' && block.data?.text) {
          const rawText = block.data.text.replace(/<[^>]*>?/gm, '');
          const id = rawText.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
          items.push({
            id,
            text: rawText,
            level: block.data.level || 2,
          });
        }
      }
    }
  }
} catch {
  // Parsing failed or plain text
}
---

{items.length > 1 && (
  <nav class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-900/40 text-sm">
    <div class="flex items-center gap-2 font-bold text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
      </svg>
      <span>Table of Contents</span>
    </div>
    <ul class="space-y-2">
      {items.map((item) => (
        <li class={item.level === 3 ? 'ml-3' : item.level >= 4 ? 'ml-6' : ''}>
          <a
            href={`#${item.id}`}
            class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors line-clamp-1 py-0.5"
          >
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
