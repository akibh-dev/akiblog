---
/* For more details, see docs/blog/implementation-notes.md#src-components-ui-tagpill-astro-note-1. */
interface Props {
  tag: string;
  count?: number;
  /** the tag of the page being viewed */
  current?: boolean;
}

const { tag, count, current = false } = Astro.props;
---

<a
  href={`/tags/${tag}/`}
  aria-current={current ? "page" : undefined}
  class="inline-flex min-h-7 items-center gap-1.5 rounded-sm border border-line-subtle bg-surface px-2.5 py-1 font-mono text-2xs text-subtle transition-colors hover:border-accent hover:text-default aria-[current=page]:border-accent aria-[current=page]:text-accent"
>
  <span aria-hidden="true" class="text-muted">#</span>{tag}
  {count !== undefined && <span class="text-muted">{count}</span>}
</a>
