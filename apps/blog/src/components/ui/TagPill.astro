---
/**
 * @file ui/TagPill.astro
 * @description Tag link pill — the portfolio's icon-pill style
 *              (apps/portfolio/src/icons/README.md "skill pill"):
 *              hairline border, mono 2xs label, brand border on hover.
 *              Optional count in text-muted.
 *
 * WHY a link (not a button/filter): every tag has a static page
 * (/tags/<tag>/), so the pill works without JS, can be opened in a new
 * tab and is crawlable. 24px+ target height (portfolio a11y contract).
 *
 * Example: <TagPill tag="cloudflare" count={3} />
 */
interface Props {
  tag: string;
  count?: number;
  /** the tag of the page being viewed */
  current?: boolean;
}

const { tag, count, current = false } = Astro.props;
---

<a
  href={`/tags/${tag}/`}
  aria-current={current ? "page" : undefined}
  class="inline-flex min-h-7 items-center gap-1.5 rounded-sm border border-line-subtle bg-surface px-2.5 py-1 font-mono text-2xs text-subtle transition-colors hover:border-accent hover:text-default aria-[current=page]:border-accent aria-[current=page]:text-accent"
>
  <span aria-hidden="true" class="text-muted">#</span>{tag}
  {count !== undefined && <span class="text-muted">{count}</span>}
</a>
