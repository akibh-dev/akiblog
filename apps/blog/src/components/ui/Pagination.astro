---
// Pagination.astro - Separated Pagination Controls Component
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

if (totalPages <= 1) {
  return null;
}

function getPageUrl(p: number): string {
  const url = new URL(baseUrl, 'http://localhost');
  if (p === 1) {
    url.searchParams.delete('page');
  } else {
    url.searchParams.set('page', String(p));
  }
  return `${url.pathname}${url.search}`;
}
---

<nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
  {currentPage > 1 ? (
    <a
      href={getPageUrl(currentPage - 1)}
      class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
    >
      ← Previous
    </a>
  ) : (
    <span class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 text-sm font-medium text-slate-400 dark:text-slate-600 cursor-not-allowed">
      ← Previous
    </span>
  )}

  <span class="px-4 py-2 text-sm text-slate-500 dark:text-slate-400 font-medium">
    Page {currentPage} of {totalPages}
  </span>

  {currentPage < totalPages ? (
    <a
      href={getPageUrl(currentPage + 1)}
      class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
    >
      Next →
    </a>
  ) : (
    <span class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 text-sm font-medium text-slate-400 dark:text-slate-600 cursor-not-allowed">
      Next →
    </span>
  )}
</nav>
