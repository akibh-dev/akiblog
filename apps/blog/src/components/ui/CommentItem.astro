---
// CommentItem.astro - Individual Comment Presentation Component
import type { CommentWithReplies } from '../../lib/services/comments';

interface Props {
  comment: CommentWithReplies;
  postId: string;
}

const { comment, postId } = Astro.props;

const dateFormatted = new Date(comment.createdAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const avatarLetter = (comment.authorName || 'A').charAt(0).toUpperCase();
---

<div class="comment-node py-4 border-b border-slate-100 dark:border-slate-800/80 last:border-b-0" id={`comment-${comment.id}`}>
  <div class="flex items-start gap-3.5">
    <div class="w-9 h-9 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold flex items-center justify-center text-sm shrink-0">
      {avatarLetter}
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-sm text-slate-900 dark:text-slate-100">{comment.authorName}</span>
          <span class="text-xs text-slate-400 dark:text-slate-500">•</span>
          <time class="text-xs text-slate-500 dark:text-slate-400" datetime={new Date(comment.createdAt).toISOString()}>{dateFormatted}</time>
        </div>

        <button
          type="button"
          class="reply-toggle-btn text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline"
          data-parent-id={comment.id}
          data-author={comment.authorName}
        >
          Reply
        </button>
      </div>

      <div class="mt-2 text-sm text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-wrap">
        {comment.content}
      </div>

      <!-- Nested Replies -->
      {comment.replies && comment.replies.length > 0 && (
        <div class="mt-4 pl-4 border-l-2 border-slate-200 dark:border-slate-800 space-y-4">
          {comment.replies.map((reply) => {
            const replyDate = new Date(reply.createdAt).toLocaleDateString('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            });
            const replyLetter = (reply.authorName || 'A').charAt(0).toUpperCase();
            return (
              <div class="py-2" id={`comment-${reply.id}`}>
                <div class="flex items-center gap-2 mb-1.5">
                  <div class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 font-semibold flex items-center justify-center text-xs">
                    {replyLetter}
                  </div>
                  <span class="font-semibold text-xs text-slate-900 dark:text-slate-100">{reply.authorName}</span>
                  <span class="text-xs text-slate-400 dark:text-slate-500">•</span>
                  <time class="text-xs text-slate-400 dark:text-slate-500">{replyDate}</time>
                </div>
                <div class="text-sm text-slate-700 dark:text-slate-300 pl-8 whitespace-pre-wrap">
                  {reply.content}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</div>
