---
// CommentForm.astro - Separated Comment Submission Form Component
interface Props {
  postId: string;
}

const { postId } = Astro.props;
---

<div class="mt-8 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-sm" id="comment-form-container">
  <div class="flex items-center justify-between mb-4">
    <h4 class="text-lg font-bold text-slate-900 dark:text-slate-100" id="form-heading">Leave a comment</h4>
    <button
      type="button"
      id="cancel-reply-btn"
      class="hidden text-xs text-rose-500 hover:text-rose-600 font-medium"
    >
      Cancel reply
    </button>
  </div>

  <form id="comment-form" class="space-y-4">
    <input type="hidden" name="postId" value={postId} />
    <input type="hidden" name="parentId" id="form-parent-id" value="" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="authorName" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1.5">
          Name *
        </label>
        <input
          type="text"
          id="authorName"
          name="authorName"
          required
          placeholder="Your name"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div>
        <label for="authorEmail" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1.5">
          Email * (kept private)
        </label>
        <input
          type="email"
          id="authorEmail"
          name="authorEmail"
          required
          placeholder="you@example.com"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
    </div>

    <div>
      <label for="content" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1.5">
        Comment *
      </label>
      <textarea
        id="content"
        name="content"
        rows="4"
        required
        placeholder="Write your comment here..."
        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
      ></textarea>
    </div>

    <div class="flex items-center justify-between pt-2">
      <div id="comment-message" class="text-sm font-medium hidden"></div>
      <button
        type="submit"
        id="comment-submit-btn"
        class="ml-auto px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition-colors shadow-sm disabled:opacity-50"
      >
        Post Comment
      </button>
    </div>
  </form>
</div>

<script>
  function setupCommentForm() {
    const form = document.getElementById('comment-form') as HTMLFormElement | null;
    const parentIdInput = document.getElementById('form-parent-id') as HTMLInputElement | null;
    const formHeading = document.getElementById('form-heading');
    const cancelReplyBtn = document.getElementById('cancel-reply-btn');
    const messageEl = document.getElementById('comment-message');
    const submitBtn = document.getElementById('comment-submit-btn') as HTMLButtonElement | null;

    if (!form) return;

    // Handle "Reply" clicks from comment items
    document.querySelectorAll('.reply-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const parentId = btn.getAttribute('data-parent-id');
        const author = btn.getAttribute('data-author');
        if (parentId && parentIdInput && formHeading && cancelReplyBtn) {
          parentIdInput.value = parentId;
          formHeading.textContent = `Reply to ${author}`;
          cancelReplyBtn.classList.remove('hidden');
          form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    // Handle cancel reply
    cancelReplyBtn?.addEventListener('click', () => {
      if (parentIdInput && formHeading && cancelReplyBtn) {
        parentIdInput.value = '';
        formHeading.textContent = 'Leave a comment';
        cancelReplyBtn.classList.add('hidden');
      }
    });

    // Form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !messageEl) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
      messageEl.className = 'text-sm font-medium hidden';

      const formData = new FormData(form);
      const payload = {
        postId: formData.get('postId'),
        parentId: formData.get('parentId') || null,
        authorName: formData.get('authorName'),
        authorEmail: formData.get('authorEmail'),
        content: formData.get('content'),
      };

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          messageEl.textContent = data.message || 'Comment submitted! It will appear once approved.';
          messageEl.className = 'text-sm font-medium text-emerald-600 dark:text-emerald-400 block';
          form.reset();
          if (parentIdInput) parentIdInput.value = '';
          if (formHeading) formHeading.textContent = 'Leave a comment';
          if (cancelReplyBtn) cancelReplyBtn.classList.add('hidden');
        } else {
          messageEl.textContent = data.error || 'Failed to submit comment.';
          messageEl.className = 'text-sm font-medium text-rose-600 dark:text-rose-400 block';
        }
      } catch (err: any) {
        messageEl.textContent = 'An error occurred while sending your comment.';
        messageEl.className = 'text-sm font-medium text-rose-600 dark:text-rose-400 block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Post Comment';
      }
    });
  }

  setupCommentForm();
  document.addEventListener('astro:after-swap', setupCommentForm);
</script>
