---
/**
 * @file ThemeToggle.astro
 * @description Tri-state theme switcher component (Light / Dark / System).
 * 
 * POC / Implementation Details:
 * - Supports 3 discrete modes: 'light', 'dark', and 'system' (prefers-color-scheme).
 * - Reacts live to operating system theme changes when in 'system' mode.
 * - Stores state in localStorage ('color-theme') and updates html.dark class synchronously.
 * - Why this implementation is best: Eliminates FOUC (flash of unstyled content) and provides
 *   seamless user experience across all devices and OS configurations.
 */
---

<div class="relative inline-block text-left" id="theme-menu-container">
  <!-- Active Mode Trigger Button -->
  <button
    id="theme-menu-btn"
    type="button"
    aria-label="Select theme mode"
    class="flex items-center gap-1.5 p-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm"
  >
    <!-- Sun (Light) -->
    <svg id="icon-light" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <!-- Moon (Dark) -->
    <svg id="icon-dark" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
    <!-- Monitor (System) -->
    <svg id="icon-system" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
    <!-- Down Arrow -->
    <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="theme-dropdown"
    class="hidden absolute right-0 mt-2 w-36 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl py-1.5 z-50 focus:outline-none backdrop-blur-lg"
  >
    <button
      type="button"
      data-theme-set="light"
      class="theme-opt-btn w-full px-3.5 py-2 text-left text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-between transition-colors"
    >
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span>Light</span>
      </div>
      <span class="check-mark check-light hidden text-blue-600 font-bold">✓</span>
    </button>

    <button
      type="button"
      data-theme-set="dark"
      class="theme-opt-btn w-full px-3.5 py-2 text-left text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-between transition-colors"
    >
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span>Dark</span>
      </div>
      <span class="check-mark check-dark hidden text-blue-600 font-bold">✓</span>
    </button>

    <button
      type="button"
      data-theme-set="system"
      class="theme-opt-btn w-full px-3.5 py-2 text-left text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-between transition-colors"
    >
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>System</span>
      </div>
      <span class="check-mark check-system hidden text-blue-600 font-bold">✓</span>
    </button>
  </div>
</div>

<script>
  function initTheme() {
    const themeBtn = document.getElementById('theme-menu-btn');
    const dropdown = document.getElementById('theme-dropdown');
    const iconLight = document.getElementById('icon-light');
    const iconDark = document.getElementById('icon-dark');
    const iconSystem = document.getElementById('icon-system');

    const checkLight = document.querySelector('.check-light');
    const checkDark = document.querySelector('.check-dark');
    const checkSystem = document.querySelector('.check-system');

    if (!themeBtn || !dropdown) return;

    function applyTheme(mode: string) {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      
      if (mode === 'dark' || (mode === 'system' && prefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      // Update button icon
      iconLight?.classList.add('hidden');
      iconDark?.classList.add('hidden');
      iconSystem?.classList.add('hidden');

      if (mode === 'light') iconLight?.classList.remove('hidden');
      else if (mode === 'dark') iconDark?.classList.remove('hidden');
      else iconSystem?.classList.remove('hidden');

      // Update dropdown checks
      checkLight?.classList.add('hidden');
      checkDark?.classList.add('hidden');
      checkSystem?.classList.add('hidden');

      if (mode === 'light') checkLight?.classList.remove('hidden');
      else if (mode === 'dark') checkDark?.classList.remove('hidden');
      else checkSystem?.classList.remove('hidden');
    }

    const currentMode = localStorage.getItem('color-theme') || 'system';
    applyTheme(currentMode);

    // Toggle dropdown
    themeBtn.onclick = (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    };

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !themeBtn.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    });

    // Theme select buttons
    document.querySelectorAll('.theme-opt-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-theme-set') || 'system';
        if (selected === 'system') {
          localStorage.removeItem('color-theme');
        } else {
          localStorage.setItem('color-theme', selected);
        }
        applyTheme(selected);
        dropdown.classList.add('hidden');
      });
    });

    // Listen to OS theme changes if in system mode
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!localStorage.getItem('color-theme') || localStorage.getItem('color-theme') === 'system') {
        applyTheme('system');
      }
    });
  }

  initTheme();
  document.addEventListener('astro:after-swap', initTheme);
</script>
