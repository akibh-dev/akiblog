---
/* For more details, see docs/blog/implementation-notes.md#src-components-ui-sectionshell-astro-note-1. */

interface Props {
  id: string;
  index?: string; // "01", "02"…
  label?: string;
  class?: string;
  pad?: string;
}

const { id, index, label, class: className = "", pad = "px-5 md:px-8 py-14 md:py-20" } = Astro.props;
const hasHeader = Astro.slots.has("header") || Boolean(index && label);
---

<section id={id} data-spy-section class:list={["relative mx-(--site-section-inset) overflow-clip border-x border-line bg-surface", className]}>
  <div class:list={["reveal-on-scroll", pad]}>
    {
      hasHeader && (
        <header class="mb-10 flex items-center gap-3">
          {
            Astro.slots.has("header") ? (
              <slot name="header" />
            ) : (
              <>
                <span class="font-mono text-2xs uppercase tracking-widest text-accent">{index}. {label}</span>
                <span class="h-px w-16 bg-line"></span>
              </>
            )
          }
        </header>
      )
    }
    <slot />
  </div>
</section>
