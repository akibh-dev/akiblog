---
// CommentList.astro - Separated Comments Container Component
import type { CommentWithReplies } from '../../lib/services/comments';
import CommentItem from './CommentItem.astro';

interface Props {
  comments: CommentWithReplies[];
  postId: string;
}

const { comments, postId } = Astro.props;
---

<div class="mt-8">
  <div class="flex items-center justify-between pb-4 border-b border-slate-200 dark:border-slate-800">
    <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
      <span>Discussion</span>
      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
        {comments.length}
      </span>
    </h3>
  </div>

  {comments.length === 0 ? (
    <div class="py-10 text-center text-slate-500 dark:text-slate-400 text-sm">
      <p>No comments yet. Be the first to share your thoughts!</p>
    </div>
  ) : (
    <div class="divide-y divide-slate-100 dark:divide-slate-800/80">
      {comments.map((comment) => (
        <CommentItem comment={comment} postId={postId} />
      ))}
    </div>
  )}
</div>
