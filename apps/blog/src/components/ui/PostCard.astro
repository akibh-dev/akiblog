---
/* For more details, see docs/blog/implementation-notes.md#src-components-ui-postcard-astro-note-1. */
import PostCover from "./PostCover.astro";
import { formatDate, postUrl, readingMinutes, type Post } from "../../lib/posts";

interface Props {
  post: Post;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel: H = "h3" } = Astro.props;
const { title, description, tags, type, date, cover, draft } = post.data;

const METER_MAX = 8;
const mins = readingMinutes(post.body);
---

<a href={postUrl(post)} class="group flex w-full flex-col">
  <div class="border-b border-line p-2">
    <PostCover title={title} slug={post.id} banner={cover} />
  </div>

  <div class="flex flex-1 flex-col px-5 pt-6 pb-5 md:px-8">
    <p class="mb-2 font-mono text-[10px] uppercase tracking-widest text-muted">
      {draft && <span class="mr-1 text-accent">draft ·</span>}
      {[type, ...tags.slice(0, 2)].join(" / ")}
    </p>
    <H class="font-display text-lg leading-snug text-balance text-default transition-colors group-hover:text-accent">
      {title}
    </H>
    <p class="mt-2 line-clamp-2 font-mono text-xs leading-relaxed text-subtle">{description}</p>

    <div class="mt-auto flex items-center justify-between gap-3 pt-6 font-mono text-2xs text-muted">
      <span class="flex items-center gap-2" title={`${mins} min read`}>
        <span class="flex gap-0.5" aria-hidden="true">
          {Array.from({ length: METER_MAX }, (_, t) => (
            <span class:list={["h-2.5 w-1", t < mins ? "bg-accent" : "bg-line-subtle"]} />
          ))}
        </span>
        {mins} min read
      </span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
  </div>
</a>
