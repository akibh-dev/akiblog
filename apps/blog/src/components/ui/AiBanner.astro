---
/**
 * @file ui/AiBanner.astro
 * @description AI-disclosure note under the post header, shown when the
 *              post's frontmatter says `ai: assisted | generated`
 *              (legacy `author: gemini` is mapped to `generated` by the
 *              content schema).
 *
 * WHY: readers deserve to know when a text was machine-written or
 * machine-assisted — stated plainly, once, at the top, without alarm
 * colors. Brand wash + left rule (docs/ui-guide §9), Sparkles glyph from
 * the portfolio icon set, role="note" so screen readers announce it as
 * an aside rather than part of the article.
 *
 * Example: <AiBanner level="generated" />
 */
import { SparklesIcon } from "../../icons";

interface Props {
  level: "assisted" | "generated";
}

const { level } = Astro.props;
const text =
  level === "generated"
    ? "This post was drafted by an AI model and reviewed by the author."
    : "Parts of this post were written with help from an AI model.";
---

<p role="note" class="mt-8 flex items-start gap-2.5 border-l-2 border-accent bg-accent-subtle px-4 py-3 font-mono text-2xs leading-relaxed text-subtle">
  <SparklesIcon class="mt-px size-4 shrink-0 text-accent" />
  <span><span class="uppercase tracking-wider text-accent">AI {level}</span> — {text}</span>
</p>
