---
/* For more details, see docs/blog/implementation-notes.md#src-components-ui-aibanner-astro-note-1. */
import { SparklesIcon } from "../../icons";

interface Props {
  level: "assisted" | "generated";
}

const { level } = Astro.props;
const text =
  level === "generated"
    ? "This post was drafted by an AI model and reviewed by the author."
    : "Parts of this post were written with help from an AI model.";
---

<p role="note" class="mt-8 flex items-start gap-2.5 border-l-2 border-accent bg-accent-subtle px-4 py-3 font-mono text-2xs leading-relaxed text-subtle">
  <SparklesIcon class="mt-px size-4 shrink-0 text-accent" />
  <span><span class="uppercase tracking-wider text-accent">AI {level}</span> — {text}</span>
</p>
