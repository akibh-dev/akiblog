---
/* For more details, see docs/blog/implementation-notes.md#src-components-layout-toctree-astro-note-1. */
import type { MarkdownHeading } from "astro";
import TocSpy from "../islands/TocSpy.astro";
import { tocRows } from "../../lib/toc";

interface Props {
  headings: MarkdownHeading[];
}

const rows = tocRows(Astro.props.headings);

const LANE = 16;
const T = 15; // node center y
const BAND = 16; // merge band height
const X = (lane: number) => 3.5 + LANE * lane;

/** vertical segment of lane `k`; insets in px from the row's top/bottom */
const vline = (k: number, top: number, bottom: number) => `left:${X(k) - 0.6}px;top:${top}px;bottom:${bottom}px`;
/** vertical segment of lane `k` from the row's top down to the node */
const vstub = (k: number) => `left:${X(k) - 0.6}px;top:0;height:${T}px`;

const segments = rows.map(({ lane, prevLane, nextLane }) => {
  const verticals: string[] = [];
  const merges: number[] = []; // lanes that end here, each merging into k-1
  // ancestor lanes passing beside this row (lane 0 = trunk, drawn elsewhere)
  for (let k = 1; k < lane; k++) {
    if (nextLane >= k) verticals.push(vline(k, 0, 0));
    else {
      verticals.push(vline(k, 0, BAND));
      merges.push(k);
    }
  }
  let fork = false;
  if (lane >= 1) {
    // into the node: continue the lane, or fork out of the parent lane
    if (prevLane >= lane) verticals.push(vstub(lane));
    else fork = true;
    // out of the node: continue to the next row, or run down and merge
    if (nextLane >= lane) verticals.push(vline(lane, T, 0));
    else {
      verticals.push(vline(lane, T, BAND));
      merges.push(lane);
    }
  }
  return { verticals, merges, fork };
});
---

<TocSpy>
  <div role="presentation">
    <nav aria-label="On this page">
      <ol class="m-0 list-none p-0">
        {
          rows.map((row, i) => {
            const { verticals, merges, fork } = segments[i];
            return (
              <li>
                <a
                  href={`#${row.slug}`}
                  data-toc-link
                  data-lane={row.lane}
                  title={row.text}
                  class:list={[
                    "group relative block pt-[7px] pr-1 pb-2 font-mono text-xs leading-4 text-muted transition-colors",
                    "hover:text-default data-trail:text-subtle aria-[current=location]:text-accent",
                    row.lane === 0 && "text-subtle",
                  ]}
                  style={`padding-left:${X(row.lane) + 15.5}px`}
                >
                  {/* branch lines — decorative, painted under the node */}
                  <span aria-hidden="true">
                    {verticals.map((style) => (
                      <span class="absolute w-[1.2px] bg-line-subtle" style={style} />
                    ))}
                    {fork && (
                      <svg class="pointer-events-none absolute inset-x-0 top-0 overflow-visible" height={T} width="100%">
                        <path d={`M${X(row.lane - 1)} 0 L${X(row.lane)} ${T}`} style="stroke: var(--ui-border-subtle); stroke-width: 1.2; fill: none; stroke-linecap: round" />
                      </svg>
                    )}
                    {merges.length > 0 && (
                      <svg class="pointer-events-none absolute inset-x-0 bottom-0 overflow-visible" height={BAND} width="100%">
                        {merges.map((k) => (
                          <path d={`M${X(k)} 0 L${X(k - 1)} ${BAND}`} style="stroke: var(--ui-border-subtle); stroke-width: 1.2; fill: none; stroke-linecap: round" />
                        ))}
                      </svg>
                    )}
                  </span>
                  {/* commit node — same 7px hollow circle as the stations */}
                  <span
                    aria-hidden="true"
                    class="absolute size-[7px] rounded-full border border-line bg-canvas transition-[transform,background-color,border-color] duration-200 group-hover:border-accent group-data-trail:border-accent group-aria-[current=location]:scale-[1.4] group-aria-[current=location]:border-accent group-aria-[current=location]:bg-accent motion-reduce:transition-none"
                    style={`left:${X(row.lane) - 3.5}px;top:${T - 3.5}px`}
                  />
                  <span class="line-clamp-2">{row.text}</span>
                </a>
              </li>
            );
          })
        }
      </ol>
    </nav>
  </div>
</TocSpy>
