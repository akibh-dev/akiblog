---
/* For more details, see docs/blog/implementation-notes.md#src-components-layout-viewportframe-astro-note-1. */

/** One opaque chrome cell: frame background + noise + hatch. Reused 4×. */
const cells = [
  {
    id: "top",
    cls: "col-span-full row-start-1 border-line md:border-b",
  },
  { id: "left", cls: "col-start-1 row-start-2 hidden md:block" },
  { id: "right", cls: "col-start-3 row-start-2 hidden md:block" },
  {
    id: "bottom",
    cls: "col-span-full row-start-3 border-line md:border-t",
  },
] as const;
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-20 grid h-dvh min-h-0 grid-cols-[var(--site-page-left)_minmax(0,1fr)_var(--site-page-right)] grid-rows-[var(--site-frame-top)_minmax(0,1fr)_var(--site-inset-bottom)] before:absolute before:inset-0 before:z-1 before:border-y before:border-line-subtle md:before:hidden"
>
  {
    cells.map((cell) => (
      <div class:list={["pointer-events-auto relative isolate chrome-bg", cell.cls]}>
        {/* noise grain over the watermark — z-[-1] keeps it under content */}
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 z-[-1] opacity-5 dark:opacity-[0.012] bg-repeat [background-size:180px] [background-image:url(/noise.webp)]"
        />
      </div>
    ))
  }

  {/* For more details, see docs/blog/implementation-notes.md#src-components-layout-viewportframe-astro-note-2. */}
  <div class="col-start-2 row-start-2 grid min-h-0 min-w-0 grid-cols-(--site-columns)">
    <div class="col-(--site-main-column) row-start-1 grid min-h-0 min-w-0 grid-cols-[var(--site-section-inset)_minmax(0,1fr)_var(--site-section-inset)] md:pr-px">
      {/* col-(--site-main-column) — same track token as <main>: 1 on mobile
          (no sidebar, full width), 2 on desktop (main column only) */}
      <div aria-hidden="true" class="pointer-events-auto relative col-start-2 row-start-1 h-(--site-rail-height) min-w-0 grid grid-cols-8 border-x border-line">
        <span class="col-span-3 bg-accent"></span>
        <span class="col-span-2 bg-(--delta-neutral-800)"></span>
        <span class="col-span-3 bg-delta-blue"></span>
      </div>
    </div>
  </div>
</div>
