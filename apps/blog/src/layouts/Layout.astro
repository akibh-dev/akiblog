---
/**
 * @file layouts/Layout.astro
 * @description Root shell — delta.dev's two-layer layout, identical to the
 *              portfolio (plan13.md):
 *
 *   1. ONE-PAINT BACKGROUND — <body> paints --site-frame-background
 *      everywhere (+ the fixed brand watermark from global.css).
 *   2. FIXED CHROME — ViewportFrame (z-20): frame cells + the 6px
 *      SEGMENTED rail ([3/8 brand | 2/8 gray | 3/8 --delta-blue]).
 *   3. SCROLLING LAYER — z-0 grid mirroring the chrome grid: sidebar
 *      column + main column; main carries pt-rail + md:border-r so panels
 *      and seams scroll BENEATH the fixed rail.
 *   4. "=" SEAMS — pages compose <SectionShell/> panels joined by <Seam/>.
 *
 * Copied from apps/portfolio/src/layouts/Layout.astro @ 091c7cf. Keep the
 * markup in sync. BLOG ADAPTATIONS:
 * - Props are forwarded to BaseHead (article SEO: image, dates, tags…);
 *   `toc` goes to SiteSidebar, which draws it as the git tree (plan22).
 * - Clean-URL in-page navigation, ported from the portfolio (plan24):
 *   `#home/#search/#tags/#posts` and TOC `#heading` clicks scroll without
 *   writing the hash into the address bar; arriving WITH a hash
 *   (/#tags from a post page, a shared /x/#setup) jumps there, then strips
 *   it. The arrival hash is kept on <html data-arrived-hash> for islands
 *   that care where the visitor was headed (search focus, TOC spy).
 * - SearchShortcut: `/` or ⌘K/Ctrl+K → /search/ from every page.
 * - A visually-hidden skip link to #main-content (a11y; posts are long
 *   and the sidebar comes first in DOM order).
 *
 * POC:
 *   <Layout title={post.data.title} description={post.data.description} article={{ … }}>
 *     <SectionShell id="intro">…</SectionShell>
 *   </Layout>
 */
import "../styles/global.css";
import ViewportFrame from "../components/layout/ViewportFrame.astro";
import SiteSidebar from "../components/layout/SiteSidebar.astro";
import MobileHeader from "../components/layout/MobileHeader.astro";
import BaseHead from "./BaseHead.astro";
import SearchShortcut from "../components/islands/SearchShortcut.astro";
import type { ComponentProps } from "astro/types";
import type { MarkdownHeading } from "astro";

type Props = ComponentProps<typeof BaseHead> & {
  /** post headings → the sidebar's git-tree TOC (plan22) */
  toc?: MarkdownHeading[];
};

const { toc, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} />
  </head>

  <body class="relative bg-frame-background text-default antialiased">
    <a
      href="#main-content"
      class="btn sr-only fixed top-3 left-3 z-50 rounded-sm px-4 py-2 font-mono text-2xs uppercase tracking-wider focus:not-sr-only"
    >
      Skip to content
    </a>
    <ViewportFrame />
    <MobileHeader />

    {/* scrolling layer — mirrors the chrome grid (same page-left/right
        margins); z-0 keeps content under the fixed chrome while still
        stacking tooltips/dialogs correctly inside it */}
    <div
      id="top"
      class="relative z-0 grid ml-(--site-page-left) mr-(--site-page-right) grid-cols-(--site-columns) pt-(--site-frame-top) pb-(--site-content-bottom)"
    >
      <SiteSidebar toc={toc} />
      {/* main content track — pt-rail leaves the 6px fixed rail visible
          above; the rail's right edge continues into main's border-r */}
      <main id="main-content" tabindex="-1" class="relative col-(--site-main-column) min-w-0 pt-(--site-rail-height) border-line md:border-r focus-visible:outline-none">
        <slot />
      </main>
    </div>
    <SearchShortcut />

    <script>
      /**
       * Clean-URL in-page navigation — the portfolio's Layout script
       * (apps/portfolio/src/layouts/Layout.astro @ 091c7cf), verbatim
       * except for `data-arrived-hash`.
       *
       * WHY: anchors keep real `#id` hrefs (no-JS fallback, middle-click,
       * copy link, crawlers), but clicks scroll without writing `#tags`,
       * `#setup`, … into the address bar or piling up history entries.
       * - ONE delegated listener covers every in-page link (stations, TOC,
       *   heading anchors, mobile menu).
       * - Native scrollIntoView, so global.css `scroll-behavior: smooth`
       *   (auto under reduced motion) and `scroll-padding-block` (land
       *   below the fixed frame) still apply.
       * - Links inside the open mobile <dialog> wait until it has closed
       *   (its scroll lock would undo the scroll).
       * - Focus moves to the target (preventScroll), like native hash nav.
       * - Arriving WITH a hash still deep-links: read → stripped with
       *   replaceState (cancels the browser's own jump) → jump instantly
       *   once loaded. Recorded on <html data-arrived-hash> first.
       */
      const cleanUrl = () => {
        if (location.hash) history.replaceState(history.state, "", location.pathname + location.search);
      };

      const focusTarget = (el: HTMLElement) => {
        if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "-1");
        el.focus({ preventScroll: true });
      };

      const scrollToId = (id: string, behavior: ScrollBehavior = "auto") => {
        if (id === "top") {
          window.scrollTo({ top: 0, behavior });
          return;
        }
        const el = document.getElementById(id);
        if (!el) return;
        el.scrollIntoView({ block: "start", behavior });
        focusTarget(el);
      };

      const whenNoDialog = (run: () => void, deadline = performance.now() + 1000) => {
        if (!document.querySelector("dialog[open]") || performance.now() > deadline) run();
        else requestAnimationFrame(() => whenNoDialog(run, deadline));
      };

      document.addEventListener("click", (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
        const id = a ? decodeURIComponent(a.getAttribute("href")!.slice(1)) : "";
        if (!a || !id || (id !== "top" && !document.getElementById(id))) return;
        e.preventDefault();
        if (a.closest("dialog")) whenNoDialog(() => scrollToId(id));
        else scrollToId(id);
      });

      const initial = decodeURIComponent(location.hash.slice(1));
      if (initial) document.documentElement.dataset.arrivedHash = initial;
      cleanUrl();
      if (initial) {
        const jump = () => scrollToId(initial, "instant");
        if (document.readyState === "complete") jump();
        else window.addEventListener("load", jump, { once: true });
      }
      window.addEventListener("hashchange", cleanUrl);
    </script>
  </body>
</html>
