---
/**
 * @file layouts/BaseHead.astro
 * @description Everything inside <head>, shared by every page (index, posts,
 *              tags, search, 404): charset/viewport, SEO + social metadata,
 *              structured data, anti-flash theme init, self-hosted fonts.
 *
 * Copied from apps/portfolio/src/layouts/BaseHead.astro @ 091c7cf — fonts,
 * theme init and CSP ordering are byte-identical; keep those in sync.
 * BLOG ADAPTATION: an ARTICLE mode on top of the portfolio's WEBSITE mode.
 *
 * SEO / SOCIAL (what each tag is for):
 * - <link rel="canonical">: one URL per page; a post may override it with
 *   frontmatter `canonical` when it was first published elsewhere.
 * - Open Graph: `article` + published/modified time + one `article:tag`
 *   per tag for posts; `website` elsewhere. og:image is ABSOLUTE (crawlers
 *   don't resolve relative URLs) and 1200×630 — posts pass their cover
 *   (rendered to JPEG by the page, see pages/[slug].astro), others
 *   fall back to public/og.png.
 * - JSON-LD: WebSite on every page; BlogPosting + BreadcrumbList on posts (headline,
 *   description, image, dates, keywords, author → the portfolio's Person
 *   node `https://akibh.dev/#person`, so Google links blog + portfolio).
 * - `keywords` meta: ignored by Google, still read by Bing/aggregators —
 *   cheap, so emitted (plan19 §2.1 note).
 * - `noindex`: drafts in preview builds, the 404, thin tag pages.
 *
 * CSP NOTE (from the portfolio): Astro writes its CSP <meta> AFTER this
 * head content, so the inline anti-flash script runs before the policy
 * applies. Keep it inline and first.
 *
 * POC:
 *   <BaseHead title="…" description="…" />
 *   <BaseHead title={post.title} description={…} article={{ published, modified, tags }} image={ogUrl} />
 *   <BaseHead title="404 — Not found" noindex />
 */
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** absolute or root-relative URL of a 1200×630 image */
  image?: string;
  imageAlt?: string;
  /** override the computed canonical URL */
  canonical?: string;
  keywords?: readonly string[];
  /** present → og:type article + BlogPosting JSON-LD */
  article?: {
    published: Date;
    modified?: Date;
    tags: readonly string[];
  };
  /** keep the page out of search indexes */
  noindex?: boolean;
}

const {
  title: pageTitle,
  description = site.description,
  image,
  imageAlt,
  keywords,
  article,
  noindex = false,
} = Astro.props;

/* home: "akiblog — notes by Md Akib Hasan" (33 chars). The tagline is 70
   chars — as a title Google truncates it at ~60, so it lives in the
   description instead (plan28). */
const title = pageTitle ? `${pageTitle} — ${site.name}` : `${site.name} — notes by ${site.author.name}`;
const origin = Astro.site ?? new URL(site.url);
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(image ?? "/og.png", origin).href;
const xHandle = site.socials.find((s) => s.name === "X")?.handle;
const personId = `${site.portfolioUrl}/#person`;

const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${origin.origin}/#website`,
    url: origin.origin,
    name: site.name,
    description: site.description,
    publisher: { "@id": personId },
    inLanguage: "en",
  },
];
if (article) {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${canonical}#post`,
    mainEntityOfPage: canonical,
    headline: pageTitle,
    description,
    image: ogImage,
    datePublished: article.published.toISOString(),
    dateModified: (article.modified ?? article.published).toISOString(),
    keywords: (keywords ?? article.tags).join(", "),
    author: { "@type": "Person", "@id": personId, name: site.author.name, url: site.portfolioUrl },
    isPartOf: { "@id": `${origin.origin}/#website` },
    inLanguage: "en",
  });
  // breadcrumb trail in search results: akiblog › <post title>
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: site.name, item: `${origin.origin}/` },
      { "@type": "ListItem", position: 2, name: pageTitle, item: canonical },
    ],
  });
}
const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author.name} />
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} — RSS`} href="/rss.xml" />
{/* posts: plain-Markdown copy for LLM agents (pages/[slug].md.ts, llmstxt.org) */}
{article && <link rel="alternate" type="text/markdown" href={canonical.replace(/\/$/, ".md")} />}
<meta name="theme-color" content="#fcf7f7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1c1f23" media="(prefers-color-scheme: dark)" />

{/* Open Graph + Twitter */}
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle ?? title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? pageTitle ?? site.name} />
<meta property="og:locale" content="en_US" />
{
  article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
      <meta property="article:author" content={site.portfolioUrl} />
      {article.tags.map((t) => <meta property="article:tag" content={t} />)}
    </>
  )
}
<meta name="twitter:card" content="summary_large_image" />
{xHandle && <meta name="twitter:creator" content={`@${xHandle}`} />}

{!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<script is:inline>
  (() => {
    const t = localStorage.getItem("theme");
    if (t !== "light") document.documentElement.classList.add("dark");
  })();
</script>

<link rel="preload" href="/fonts/iAWriterQuattroV.woff2" as="font" type="font/woff2" crossorigin />

<style is:inline>
  @font-face {
    font-family: "iA Writer Quattro S";
    src: url("/fonts/iAWriterQuattroV.woff2") format("woff2");
    font-weight: 100 900;
    font-display: swap;
  }
  @font-face {
    font-family: "IBM Plex Serif";
    src: url("/fonts/IBMPlexSerif-Var.woff2") format("woff2");
    font-weight: 100 900;
    font-display: swap;
  }
  @font-face {
    font-family: "Lilex";
    src: url("/fonts/Lilex-Regular.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }
</style>
