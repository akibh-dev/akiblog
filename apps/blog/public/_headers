# For more details, see docs/blog/implementation-notes.md#public-headers-note-1.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# For more details, see docs/blog/implementation-notes.md#public-headers-note-2.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/:slug/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/tags/:tag/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/feed/:n/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Pagefind index: filenames are only partly hashed and every deploy replaces
# the index, so a short cache (not immutable). plan21 §2.
/pagefind/*
  Cache-Control: public, max-age=3600

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

# giscus themes (public/giscus/*.css) are fetched by the giscus iframe
# (origin https://giscus.app). Short cache: re-resolved tokens ship at once.
/giscus/*
  Access-Control-Allow-Origin: https://giscus.app
  Cache-Control: public, max-age=3600

# Post list for the portfolio's Writings section (pages/posts.json.ts):
# readable cross-origin, but only by the portfolio.
/posts.json
  Access-Control-Allow-Origin: https://akibh.dev
  Cache-Control: public, max-age=300
