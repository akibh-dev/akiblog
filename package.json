{
  "name": "akiblog-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "akiblog monorepo — portfolio (akib35.dev) + static blog (blog.akib35.dev), Astro + Tailwind v4 on Cloudflare Pages",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "turbo run dev",
    "dev:blog": "bun --filter blog dev",
    "dev:portfolio": "bun --filter portfolio dev",
    "build": "turbo run build",
    "build:blog": "bun --filter blog build",
    "build:portfolio": "bun --filter portfolio build",
    "preview:blog": "bun --filter blog preview",
    "preview:portfolio": "bun --filter portfolio preview",
    "deploy:blog": "bun apps/blog/scripts/deploy.ts",
    "preview:blog:pages": "bun --filter blog preview:pages"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
