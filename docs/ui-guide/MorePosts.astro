---
interface PostItem {
  title: string;
  href: string;
  author: {
    name: string;
    avatar: string;
  };
  date: string;
  isExternal?: boolean;
  featured?: boolean;
}

interface Props {
  posts?: PostItem[];
}

const defaultPosts: PostItem[] = [
  {
    title: "Introducing Delta",
    href: "https://zed.dev/blog/introducing-delta",
    author: {
      name: "Nathan Sobo",
      avatar: "https://avatars.githubusercontent.com/u/1789?v=4"
    },
    date: "Aug 12, 2026",
    isExternal: true,
    featured: true
  },
  {
    title: "Beyond Pass Rate: Harness Evals, and Their Blind Spots",
    href: "/blog/beyond-pass-rate",
    author: {
      name: "Anant Goel",
      avatar: "https://avatars.githubusercontent.com/u/3103248?v=4"
    },
    date: "Sep 24, 2026",
    featured: false
  },
  {
    title: "Replace PRs with Delta – Now in Public Beta",
    href: "https://zed.dev/blog/delta-public-beta",
    author: {
      name: "Nathan Sobo",
      avatar: "https://avatars.githubusercontent.com/u/1789?v=4"
    },
    date: "Sep 16, 2026",
    isExternal: true,
    featured: true
  }
];

const { posts = defaultPosts } = Astro.props;
---

<section aria-labelledby="more-posts-heading" class="border-t border-delta bg-[var(--delta-surface)]/20">
  <header class="relative isolate border-b border-delta px-4 py-3 md:px-6 lg:px-8 bg-[var(--delta-surface)]/40">
    <h2 id="more-posts-heading" class="font-serif text-sm tracking-tight italic text-[var(--delta-text)]">
      More from the blog
    </h2>
  </header>

  <ul class="list-none m-0 p-0 divide-y divide-delta">
    {posts.map((post) => (
      <li class="relative flex min-w-0 flex-col gap-2 p-4 md:flex-row md:items-center md:gap-4 md:px-6 lg:px-8 hover:bg-[var(--delta-surface)] transition-colors">

        <!-- Post Title -->
        <h3 class="min-w-0 font-serif text-sm leading-snug tracking-tight text-[var(--delta-text)] m-0">
          <a
            href={post.href}
            target={post.isExternal ? "_blank" : undefined}
            rel={post.isExternal ? "noreferrer" : undefined}
            class="after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-[var(--delta-brand)] text-inherit no-underline hover:text-[var(--delta-brand)] transition-colors"
          >
            <span>{post.title}</span>
            {post.isExternal && (
              <span class="ml-1.5 text-xs text-[var(--delta-text-subtle)]">↗</span>
            )}
          </a>
        </h3>

        <!-- Responsive horizontal line spacer -->
        <span aria-hidden="true" class="hidden w-full border-t border-delta opacity-50 md:flex md:flex-1"></span>

        <!-- Metadata row -->
        <div class="flex flex-row-reverse items-center justify-end md:flex-row gap-3">
          {post.featured && (
            <span class="px-1.5 py-0.5 font-mono text-[10px] tracking-wider uppercase border border-[var(--delta-brand)] text-[var(--delta-brand)] bg-[var(--delta-brand)]/5 rounded-[1px]">
              Featured
            </span>
          )}

          <span class="flex min-w-0 items-center gap-2">
            <span class="flex size-4.5 shrink-0 overflow-hidden rounded-full border border-delta">
              <img
                src={post.author.avatar}
                alt={post.author.name}
                title={post.author.name}
                width="18"
                height="18"
                loading="lazy"
                decoding="async"
                class="size-full object-cover"
              />
            </span>
          </span>

          <span class="h-3.5 w-px border-l border-delta"></span>

          <time datetime={post.date} class="shrink-0 font-mono text-xs text-[var(--delta-text-subtle)] md:min-w-[5rem] md:text-right">
            {post.date}
          </time>
        </div>

      </li>
    ))}
  </ul>
</section>
